# examples/graphics/clear_window — open a real X11 window, clear it to a
# solid color through the std/graphics/backend contract, and close it
# cleanly. Needs a real (or virtual, e.g. Xvfb) X display to run against —
# see tests/gl/backend_contract for the same thing under Xvfb.
# Run it with: przp run   (from this directory)

import(win = "std/graphics/window")
import(gl  = "std/graphics/gl")

fn main() -> i32 {
    display: *u8 = win.XOpenDisplay(null)
    if display == null {
        @perr("XOpenDisplay")
        ret 1
    }

    screen: i32 = win.XDefaultScreen(display)
    root: u64 = win.XRootWindow(display, screen)
    window: u64 = win.XCreateSimpleWindow(display, root, 0, 0, 640u32, 480u32, 1u32, 0u64, 0u64)
    win.XStoreName(display, window, "clear_window".data)
    win.XMapWindow(display, window)
    win.XFlush(display)

    ctx: *u8 = gl.GL_BACKEND.init(display, window)
    if ctx == null {
        @epf("failed to create a GL context on this display\n")
        ret 1
    }

    gl.GL_BACKEND.clear(ctx, 0.1, 0.4, 0.7, 1.0)
    gl.GL_BACKEND.present(ctx)
    @pf("cleared the window to a solid blue\n")

    gl.GL_BACKEND.shutdown(ctx)
    win.XDestroyWindow(display, window)
    win.XCloseDisplay(display)
    @pf("done\n")
    ret 0
}
