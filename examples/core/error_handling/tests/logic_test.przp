import(t = "../src/logic")

test "divide" {
    q, err: !i32 = t.divide(10, 2)
    @assert(err == 0)
    @assert(q == 5)
}

test "divide by zero fails" {
    _, err: !i32 = t.divide(10, 0)
    @assert(err != 0)
}

test "parse_port valid" {
    port, err: !i32 = t.parse_port("8080")
    @assert(err == 0)
    @assert(port == 8080)
}

test "parse_port out of range" {
    _, err: !i32 = t.parse_port("99999")
    @assert(err != 0)
}

test "parse_port not a number" {
    _, err: !i32 = t.parse_port("nope")
    @assert(err != 0)
}
