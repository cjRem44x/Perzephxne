# Failable (!T) return values — errors as values, no exceptions.

fn divide(a: i32, b: i32) -> !i32 {
    if b == 0 { ret @err(1) }
    ret @ok(a / b)
}

fn parse_port(s: str) -> !i32 {
    val, err: !i32 = @i32(s)
    if err != 0 { ret @err(1) }             # not a number
    if val < 1 || val > 65535 { ret @err(2) }
    ret @ok(val)
}
