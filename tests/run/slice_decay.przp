fn sum(s: []i32) -> i32 {
    total: i32 = 0
    for v => s { total += v }
    ret total
}

fn main() -> i32 {
    # let init from array literal
    s: []f64 = [1.0, 2.0, 3.0]
    @pf("{s.len} {s[1]}\n")

    # let init from array variable
    arr: [3]i32 = [10, 20, 30]
    s2: []i32 = arr
    @pf("{s2[2]}\n")

    # call argument: variable and literal
    @pf("{sum(arr)}\n")
    @pf("{sum([1, 2, 3, 4])}\n")

    # reassignment
    s2 = [5, 6, 7]
    @pf("{s2[0]} {s2.len}\n")

    # contextual element typing: literal adopts declared element type
    w: []i64 = [1, 2, 3]
    @pf("{w[2]}\n")

    ret 0
}
