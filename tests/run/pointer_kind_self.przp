struct vec2 { x: i32, y: i32 }

impl vec2 {
    fn new(x: i32, y: i32) -> vec2 { ret vec2{.x=x, .y=y} }
    fn print_raw(slf: *vec2) { @pf("raw: {slf.x} {slf.y}\n") }
    fn print_val(self: vec2) { @pf("val: {self.x} {self.y}\n") }
    fn print_smart(self: ^vec2) { @pf("smart: {self.x} {self.y}\n") }
    fn scale(self: *vec2, k: i32) {
        self.x *= k
        self.y *= k
    }
}

fn main() -> i32 {
    # plain value receiver auto-addresses for a raw-self method
    v := vec2.new(4, 12)
    v.print_raw()

    # plain value receiver calling a by-value-self method
    v.print_val()

    # raw pointer, matching raw self — the correctly-typed @alo pattern
    p: *vec2 = @alo(vec2)
    p.* = vec2.new(1, 2)
    p.print_raw()
    p.print_val()

    # smart pointer, matching smart self — the correctly-typed @new pattern
    q: ^vec2 = @new(vec2)
    q.^ = vec2.new(401, 456)
    q.print_smart()

    # mutation through a raw self param
    v.scale(2)
    v.print_raw()

    ret 0
}
