import(os = "std/os")

fn main() -> i32 {
    cwd: str = os.cwd()
    missing: str = os.getenv_str("PRZP_TEST_MISSING_ENV")
    ok: bool = cwd.len > 0 && missing.len == 0
    @pf("{ok}\n")

    # regression: mkdir_dir's own doc comment promises "true on success or
    # if it already exists," but it used to only check mkdir()'s return
    # value, which fails (EEXIST) on an already-existing directory — the
    # second call here used to return false.
    os.rmdir_dir("tests/tmp/std_os_mkdir")
    first: bool = os.mkdir_dir("tests/tmp/std_os_mkdir")
    second: bool = os.mkdir_dir("tests/tmp/std_os_mkdir")
    is_dir_r: bool = os.is_dir("tests/tmp/std_os_mkdir")
    is_dir_missing: bool = os.is_dir("tests/tmp/std_os_mkdir_does_not_exist")
    os.rmdir_dir("tests/tmp/std_os_mkdir")
    @pf("{first} {second} {is_dir_r} {is_dir_missing}\n")

    t0: i64 = os.monotonic_ms()
    os.sleep_ms(20)
    slept: bool = os.monotonic_ms() - t0 >= 20

    t1: i64 = os.monotonic_ms()
    os.waste_ms(20)
    wasted: bool = os.monotonic_ms() - t1 >= 20

    @pf("{slept} {wasted}\n")
    ret 0
}
