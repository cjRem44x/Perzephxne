# std/graphics/window — X11 windowing (first backend; see book/graphics.md)
#
# Thin, dumb extern fn bindings to Xlib — no idiomatic wrapping here (that
# lives in std/graphics). This layer exists so a higher layer, and anyone
# who needs to drop to raw Xlib, have something honest to build on.
#
# XEvent is a 192-byte C union; every event variant shares "type" at byte
# offset 0 and "window"/"event" (the window the event is reported to) at
# byte offset 32. ClientMessage additionally has "message_type" (an Atom)
# at offset 40 and its data union at offset 56; KeyPress/KeyRelease and
# ButtonPress/ButtonRelease share "keycode"/"button" (both plain `unsigned
# int`) at offset 84; ButtonPress/Release and MotionNotify share "x"/"y"
# at offsets 64/68; ConfigureNotify has "width"/"height" at offsets 56/60.
# These offsets were checked against a real compile of <X11/Xlib.h> on
# x86-64 Linux (offsetof each field), not guessed — Xlib gives no other
# portable way to read event fields from a bare byte buffer without a full
# struct-by-value FFI binding for XEvent.

extern fn XOpenDisplay(name: *u8) -> *u8
extern fn XCloseDisplay(display: *u8) -> i32
extern fn XDefaultScreen(display: *u8) -> i32
extern fn XRootWindow(display: *u8, screen: i32) -> u64
extern fn XCreateSimpleWindow(display: *u8, parent: u64, x: i32, y: i32,
                               w: u32, h: u32, border_w: u32, border: u64, bg: u64) -> u64
extern fn XDestroyWindow(display: *u8, window: u64) -> i32
extern fn XMapWindow(display: *u8, window: u64) -> i32
extern fn XStoreName(display: *u8, window: u64, name: *u8) -> i32
extern fn XSelectInput(display: *u8, window: u64, mask: i64) -> i32
extern fn XInternAtom(display: *u8, name: *u8, only_if_exists: i32) -> u64
extern fn XSetWMProtocols(display: *u8, window: u64, protocols: *u64, count: i32) -> i32
extern fn XNextEvent(display: *u8, event_out: *u8) -> i32
extern fn XPending(display: *u8) -> i32
extern fn XFlush(display: *u8) -> i32
extern fn XSendEvent(display: *u8, window: u64, propagate: i32, mask: i64, event: *u8) -> i32
extern fn XSetWMNormalHints(display: *u8, window: u64, hints: *u8) -> i32
extern fn memset(dst: *u8, val: i32, n: usize) -> *u8

# KeySym for a given (Display, KeyCode, index). index 0 is the plain
# (unshifted) symbol, which is all the Key mapping in std/graphics needs
# today. Deprecated in favor of XGetKeyboardMapping in modern Xlib, but
# still a real exported symbol and far simpler for a single-keycode lookup.
extern fn XKeycodeToKeysym(display: *u8, keycode: u8, index: i32) -> u64

EVENT_SIZE: usize = 192

EVENT_KEY_PRESS:        i32 = 2
EVENT_KEY_RELEASE:      i32 = 3
EVENT_BUTTON_PRESS:     i32 = 4
EVENT_BUTTON_RELEASE:   i32 = 5
EVENT_MOTION_NOTIFY:    i32 = 6
EVENT_CONFIGURE_NOTIFY: i32 = 22
EVENT_CLIENT_MESSAGE:   i32 = 33

MASK_KEY_PRESS:        i64 = 1
MASK_KEY_RELEASE:      i64 = 2
MASK_BUTTON_PRESS:     i64 = 4
MASK_BUTTON_RELEASE:   i64 = 8
MASK_POINTER_MOTION:   i64 = 64
MASK_STRUCTURE_NOTIFY: i64 = 131072

# The mask std/graphics registers by default: enough to track key state,
# mouse position/buttons, and resizes, without also asking for every
# unrelated event class (e.g. focus/enter/leave) it doesn't read yet.
# = MASK_KEY_PRESS | MASK_KEY_RELEASE | MASK_BUTTON_PRESS |
#   MASK_BUTTON_RELEASE | MASK_POINTER_MOTION | MASK_STRUCTURE_NOTIFY
#   (1 + 2 + 4 + 8 + 64 + 131072), written as one literal since these bits
#   never overlap and a global's constant initializer can't reference
#   other globals yet (see Status & Next Work).
INPUT_MASK: i64 = 131151

# event_type: the event's type tag (byte offset 0 in every XEvent variant)
fn event_type(buf: *u8) -> i32 {
    p: *i32 = buf
    ret p.*
}

# event_window: the target window ID (byte offset 32 in every XEvent variant)
fn event_window(buf: *u8) -> u64 {
    p: *u64 = buf + 32
    ret p.*
}

# event_client_message_type: the ClientMessage's Atom (byte offset 40)
fn event_client_message_type(buf: *u8) -> u64 {
    p: *u64 = buf + 40
    ret p.*
}

# event_client_data_l0: the first long of a ClientMessage's data union
# (byte offset 56) — WM_PROTOCOLS ClientMessages carry the requested
# protocol's Atom (e.g. WM_DELETE_WINDOW) here.
fn event_client_data_l0(buf: *u8) -> i64 {
    p: *i64 = buf + 56
    ret p.*
}

# event_keycode: the raw hardware keycode (byte offset 84) of a
# KeyPress/KeyRelease event. Pass to XKeycodeToKeysym to get a portable
# key symbol.
fn event_keycode(buf: *u8) -> u32 {
    p: *u32 = buf + 84
    ret p.*
}

# event_button: the button number (byte offset 84 — the same union slot
# XKeyEvent.keycode occupies) of a ButtonPress/ButtonRelease event. 1=left,
# 2=middle, 3=right on a standard 3-button mouse.
fn event_button(buf: *u8) -> u32 {
    p: *u32 = buf + 84
    ret p.*
}

# event_x / event_y: pointer position (byte offsets 64/68) of a
# ButtonPress/ButtonRelease/MotionNotify event, relative to the event
# window's origin.
fn event_x(buf: *u8) -> i32 {
    p: *i32 = buf + 64
    ret p.*
}

fn event_y(buf: *u8) -> i32 {
    p: *i32 = buf + 68
    ret p.*
}

# event_width / event_height: the window's new size (byte offsets 56/60)
# on a ConfigureNotify event.
fn event_width(buf: *u8) -> i32 {
    p: *i32 = buf + 56
    ret p.*
}

fn event_height(buf: *u8) -> i32 {
    p: *i32 = buf + 60
    ret p.*
}

# XSizeHints is 76 bytes on x86-64 Linux (checked against a real compile
# of <X11/Xutil.h>, offsetof each field), padded to 80 for the struct's
# own 8-byte alignment (long flags at offset 0). SIZE_HINTS_SIZE is that
# padded size — enough room for XSetWMNormalHints to read the whole
# struct without running past a caller's buffer.
SIZE_HINTS_SIZE: usize = 80

# PMinSize/PMaxSize: the two XSizeHints.flags bits fill_size_hints sets —
# "min_width/min_height are meaningful" and "max_width/max_height are
# meaningful" respectively. Every other XSizeHints field (position, resize
# increment, aspect ratio, ...) is left zeroed and untouched by any flag,
# so the window manager ignores it, exactly like the "ignore fields whose
# flag bit isn't set" convention XSizeHints is designed around.
PMinSize: i64 = 16
PMaxSize: i64 = 32

# fill_size_hints: builds a fresh, fully-zeroed XSizeHints image in `buf`
# (must be >= SIZE_HINTS_SIZE bytes) with just `flags`, min_width/
# min_height (offsets 24/28), and max_width/max_height (offsets 32/36)
# set — the only fields std/graphics's resizable/min-size/max-size window
# controls need. Zeroing first (rather than trusting an `undef` buffer's
# unset bytes to be harmless) means every field XSetWMNormalHints reads
# has a defined value even though only min/max are ever populated.
fn fill_size_hints(buf: *u8, flags: i64, min_w: i32, min_h: i32, max_w: i32, max_h: i32) {
    memset(buf, 0, SIZE_HINTS_SIZE)
    fp: *i64 = buf
    fp.* = flags
    minw: *i32 = buf + 24
    minw.* = min_w
    minh: *i32 = buf + 28
    minh.* = min_h
    maxw: *i32 = buf + 32
    maxw.* = max_w
    maxh: *i32 = buf + 36
    maxh.* = max_h
}
