# std/graphics/gl — OpenGL backend (first implementation of the backend
# contract; see book/graphics.md and std/graphics/backend). GLX handles
# context creation and presenting a frame; core GL 1.1 entry points
# (glClear, glViewport, ...) are real exported libGL.so symbols, so no
# runtime function loading is needed yet. That changes the moment
# shader-based rendering needs GL 2.0+ entry points (glCreateShader and
# friends aren't link-time symbols) — see book/graphics.md's open
# prerequisites for the loader that unblocks that.
#
# The draw_rect/draw_circle/draw_line helpers below use GL 1.1's legacy
# immediate-mode calls (glBegin/glVertex2f/glColor4f) rather than vertex
# buffers — real, exported, link-time symbols on every desktop GL
# implementation (including Mesa's compat profile), so they need none of
# the runtime function loading GL 2.0+ would. std/graphics calls these
# directly for now (bypassing std/graphics/backend.Backend entirely for
# drawing) since Backend has no submit-geometry field yet — see
# std/graphics/backend's scope note. That's a deliberate, temporary
# coupling: std/graphics only has one backend today, so there's nothing
# to be backend-agnostic about yet. It goes away the day Backend grows a
# real submit entry point and a second backend exists to justify one.

import(win = "window")
import(be  = "backend")
import(m   = "std/math")

extern fn glXChooseVisual(display: *u8, screen: i32, attribs: *i32) -> *u8
extern fn glXCreateContext(display: *u8, vis: *u8, share: *u8, direct: i32) -> *u8
extern fn glXMakeCurrent(display: *u8, drawable: u64, ctx: *u8) -> i32
extern fn glXSwapBuffers(display: *u8, drawable: u64)
extern fn glXDestroyContext(display: *u8, ctx: *u8)

extern fn glClearColor(r: f32, g: f32, b: f32, a: f32)
extern fn glClear(mask: u32)
extern fn glViewport(x: i32, y: i32, w: i32, h: i32)
extern fn glGetError() -> u32
extern fn glReadPixels(x: i32, y: i32, w: i32, h: i32, format: u32, ty: u32, data: *u8)

extern fn glMatrixMode(mode: u32)
extern fn glLoadIdentity()
extern fn glOrtho(left: f64, right: f64, bottom: f64, top: f64, near: f64, far: f64)
extern fn glBegin(mode: u32)
extern fn glEnd()
extern fn glVertex2f(x: f32, y: f32)
extern fn glColor4f(r: f32, g: f32, b: f32, a: f32)
extern fn glEnable(cap: u32)
extern fn glDisable(cap: u32)

extern fn glGenTextures(n: i32, textures: *u32)
extern fn glDeleteTextures(n: i32, textures: *u32)
extern fn glBindTexture(target: u32, texture: u32)
extern fn glTexParameteri(target: u32, pname: u32, param: i32)
extern fn glTexImage2D(target: u32, level: i32, internalformat: i32, w: i32, h: i32,
                        border: i32, format: u32, ty: u32, data: *u8)
extern fn glTexCoord2f(s: f32, t: f32)

GL_COLOR_BUFFER_BIT: u32 = 0x00004000
GL_RGB:  u32 = 0x1907
GL_RGBA: u32 = 0x1908
GL_UNSIGNED_BYTE: u32 = 0x1401
GL_NO_ERROR: u32 = 0

GL_TEXTURE_2D:        u32 = 0x0DE1
GL_TEXTURE_MIN_FILTER: u32 = 0x2801
GL_TEXTURE_MAG_FILTER: u32 = 0x2800
GL_TEXTURE_WRAP_S:    u32 = 0x2802
GL_TEXTURE_WRAP_T:    u32 = 0x2803
GL_NEAREST:           u32 = 0x2600
GL_CLAMP_TO_EDGE:     u32 = 0x812F

GL_LINES:        u32 = 0x0001
GL_TRIANGLE_FAN: u32 = 0x0006
GL_QUADS:        u32 = 0x0007
GL_PROJECTION:   u32 = 0x1701
GL_MODELVIEW:    u32 = 0x1700

GLX_RGBA: i32 = 4
GLX_DEPTH_SIZE: i32 = 12
GLX_DOUBLEBUFFER: i32 = 5

TAU: f64 = 6.283185307179586

# Circle approximation quality: fixed segment count rather than an argument
# std/graphics's draw_circle takes, since a raylib-shaped call
# (draw_circle(x, y, r, color)) has no room for one and 32 segments is
# smooth enough at the sizes a 2D UI/game draws circles at.
CIRCLE_SEGMENTS: i32 = 32

# Choose an RGBA, double-buffered, 24-bit-depth-buffer visual. Returns null
# (a GLXChooseVisual failure) if the display can't offer one.
fn choose_visual(display: *u8, screen: i32) -> *u8 {
    attribs: [5]i32 = [GLX_RGBA, GLX_DEPTH_SIZE, 24, GLX_DOUBLEBUFFER, 0]
    ret glXChooseVisual(display, screen, &attribs[0])
}

# Create a GL context and make it current on `window`. `window` is expected
# to come from std/graphics/window's XCreateSimpleWindow (the default
# visual, not necessarily the one `vis` describes) — Mesa's GLX accepted
# that mismatch in testing under Xvfb; a stricter GLX implementation might
# not, at which point the window would need creating with `vis` directly
# via XCreateWindow's fuller, attributes-struct API instead of
# XCreateSimpleWindow. Returns null on failure (bad context, or a visual
# mismatch glXMakeCurrent refuses).
fn create_context(display: *u8, window: u64, vis: *u8) -> *u8 {
    ctx: *u8 = glXCreateContext(display, vis, null, 1)
    if ctx == null { ret null }
    ok: i32 = glXMakeCurrent(display, window, ctx)
    if ok == 0 { ret null }
    ret ctx
}

fn clear(r: f32, g: f32, b: f32, a: f32) {
    glClearColor(r, g, b, a)
    glClear(GL_COLOR_BUFFER_BIT)
}

fn swap(display: *u8, window: u64) {
    glXSwapBuffers(display, window)
}

fn destroy_context(display: *u8, ctx: *u8) {
    glXDestroyContext(display, ctx)
}

# ── 2D drawing (legacy GL 1.1 immediate mode) ───────────────────────────────

# set_ortho_2d: point the projection at a top-left-origin, Y-down pixel
# space sized w x h — (0, 0) is the top-left corner and (w, h) the
# bottom-right, matching screen/raylib coordinate conventions rather than
# GL's default bottom-left-origin, Y-up NDC cube. Call once per resize
# (including the first frame), before any draw_* call.
fn set_ortho_2d(w: i32, h: i32) {
    glMatrixMode(GL_PROJECTION)
    glLoadIdentity()
    glOrtho(0.0, @f64(w), @f64(h), 0.0, -1.0, 1.0)
    glMatrixMode(GL_MODELVIEW)
    glLoadIdentity()
}

# draw_rect: an axis-aligned filled rectangle with its top-left corner at
# (x, y), in the pixel space set_ortho_2d establishes.
fn draw_rect(x: f32, y: f32, w: f32, h: f32, r: f32, g: f32, b: f32, a: f32) {
    glColor4f(r, g, b, a)
    glBegin(GL_QUADS)
    glVertex2f(x, y)
    glVertex2f(x + w, y)
    glVertex2f(x + w, y + h)
    glVertex2f(x, y + h)
    glEnd()
}

# draw_circle: a filled circle centered at (cx, cy), approximated as a
# CIRCLE_SEGMENTS-sided regular polygon (a triangle fan around the center).
fn draw_circle(cx: f32, cy: f32, radius: f32, r: f32, g: f32, b: f32, a: f32) {
    glColor4f(r, g, b, a)
    glBegin(GL_TRIANGLE_FAN)
    glVertex2f(cx, cy)
    i: i32 = 0
    while i <= CIRCLE_SEGMENTS {
        theta: f64 = TAU * (@f64(i) / @f64(CIRCLE_SEGMENTS))
        vx: f32 = cx + radius * @f32(m.cos(theta))
        vy: f32 = cy + radius * @f32(m.sin(theta))
        glVertex2f(vx, vy)
        i += 1
    }
    glEnd()
}

# draw_line: a single-pixel-wide line segment from (x1, y1) to (x2, y2).
fn draw_line(x1: f32, y1: f32, x2: f32, y2: f32, r: f32, g: f32, b: f32, a: f32) {
    glColor4f(r, g, b, a)
    glBegin(GL_LINES)
    glVertex2f(x1, y1)
    glVertex2f(x2, y2)
    glEnd()
}

# ── Textures ─────────────────────────────────────────────────────────────────

# create_texture: upload w*h*channels raw pixel bytes (channels = 3 for RGB,
# 4 for RGBA, row-major, top row first — exactly what std/image's Image
# produces) as a new GL texture, returning its id. Nearest-neighbor
# filtering and edge-clamped wrapping: a reasonable, simple default for 2D
# sprite/UI work, where linear filtering usually just blurs pixel art and
# wrapping past the edge is rarely wanted.
fn create_texture(pixels: *u8, w: i32, h: i32, channels: i32) -> u32 {
    tex: u32 = 0
    glGenTextures(1, &tex)
    glBindTexture(GL_TEXTURE_2D, tex)
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, @i32(GL_NEAREST))
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, @i32(GL_NEAREST))
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, @i32(GL_CLAMP_TO_EDGE))
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, @i32(GL_CLAMP_TO_EDGE))
    fmt: u32 = if channels == 4 { GL_RGBA } else { GL_RGB }
    glTexImage2D(GL_TEXTURE_2D, 0, @i32(fmt), w, h, 0, fmt, GL_UNSIGNED_BYTE, pixels)
    ret tex
}

fn delete_texture(tex: u32) {
    t: u32 = tex
    glDeleteTextures(1, &t)
}

# draw_textured_rect: an axis-aligned rect at (x, y) sized w x h, textured
# with `tex` at full opacity (glColor4f(1,1,1,1) so the texture's own
# colors show through unmodified). GL_TEXTURE_2D is enabled/disabled
# around the draw rather than left on globally, so it doesn't leak into
# draw_rect/draw_circle/draw_line calls elsewhere in a frame.
fn draw_textured_rect(tex: u32, x: f32, y: f32, w: f32, h: f32) {
    glEnable(GL_TEXTURE_2D)
    glBindTexture(GL_TEXTURE_2D, tex)
    glColor4f(1.0, 1.0, 1.0, 1.0)
    glBegin(GL_QUADS)
    glTexCoord2f(0.0, 0.0)
    glVertex2f(x, y)
    glTexCoord2f(1.0, 0.0)
    glVertex2f(x + w, y)
    glTexCoord2f(1.0, 1.0)
    glVertex2f(x + w, y + h)
    glTexCoord2f(0.0, 1.0)
    glVertex2f(x, y + h)
    glEnd()
    glDisable(GL_TEXTURE_2D)
}

# ── Backend contract conformance ────────────────────────────────────────────
# GLBackendCtx bundles the GLX context together with the display/window it
# was created against, so every std/graphics/backend.Backend call after
# gl_backend_init needs only the opaque `ctx` handle it returns — X11-
# specific concepts (Display*, Window id) never leak above this file, which
# is the whole point of the contract (see std/graphics/backend).

struct GLBackendCtx {
    display: *u8,
    window:  u64,
    ctx:     *u8,
}

fn gl_backend_init(display: *u8, window: u64) -> *u8 {
    screen: i32 = win.XDefaultScreen(display)
    vis: *u8 = choose_visual(display, screen)
    if vis == null { ret null }
    raw_ctx: *u8 = create_context(display, window, vis)
    if raw_ctx == null { ret null }
    bctx: *GLBackendCtx = @alo(GLBackendCtx)
    bctx.* = GLBackendCtx{.display=display, .window=window, .ctx=raw_ctx}
    ret bctx
}

fn gl_backend_clear(ctx: *u8, r: f32, g: f32, b: f32, a: f32) {
    clear(r, g, b, a)
}

fn gl_backend_present(ctx: *u8) {
    bctx: *GLBackendCtx = ctx
    swap(bctx.display, bctx.window)
}

fn gl_backend_shutdown(ctx: *u8) {
    bctx: *GLBackendCtx = ctx
    destroy_context(bctx.display, bctx.ctx)
}

GL_BACKEND: be.Backend : be.Backend{
    .init     = gl_backend_init,
    .clear    = gl_backend_clear,
    .present  = gl_backend_present,
    .shutdown = gl_backend_shutdown,
}
