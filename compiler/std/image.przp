# std/image — image decoding. PNG only, for now (see std/graphics's
# Texture, the only current consumer): 8-bit-per-channel RGB or RGBA,
# non-interlaced, no palette. That covers the overwhelming majority of
# real-world PNG exports (every common browser/paint-tool default is
# 8-bit truecolor) — 16-bit, palette (indexed-color), grayscale, and
# interlaced PNGs are rejected with a clear error rather than silently
# misdecoded. Broadening this later is a matter of extending the per-pixel
# unpacking after defiltering, not touching the chunk/defilter machinery
# itself, so it's deferred until something real needs one of those
# variants rather than built preemptively.
#
# DEFLATE decompression (PNG's IDAT payload is a zlib stream) goes through
# the system zlib via its one-shot uncompress() — real, exported, and
# available basically everywhere Perzephxne already assumes libX11/libGL
# are (see [build].link in book/build-system.md); writing INFLATE by hand
# would be a much larger, self-contained undertaking with no upside over
# linking a library every Linux system already ships. Everything else
# (chunk framing, scanline defiltering) is hand-written here — there's no
# "the rest of PNG" library worth taking on for that.

import(file = "std/file")

extern fn malloc(n: usize) -> *u8
extern fn realloc(p: *u8, n: usize) -> *u8
extern fn free(p: *u8)
extern fn memcpy(dst: *u8, src: *u8, n: usize) -> *u8
extern fn memset(dst: *u8, val: i32, n: usize) -> *u8

# zlib's one-shot decompressor: given a big-enough destination buffer,
# inflates a complete zlib stream in a single call — no need for the
# incremental z_stream API PNG doesn't require.
extern fn uncompress(dest: *u8, dest_len: *u64, source: *u8, source_len: u64) -> i32

struct Image {
    width:    i32,
    height:   i32,
    channels: i32,   # 3 (RGB) or 4 (RGBA)
    pixels:   *u8,   # width * height * channels bytes, row-major, top row first
}

fn free_image(img: Image) {
    if img.pixels != null { free(img.pixels) }
}

# read_be32: big-endian u32 at buf[0..4] — every PNG chunk length/CRC, and
# IHDR's width/height, are big-endian.
fn read_be32(buf: *u8) -> u32 {
    b0: u32 = @u32(buf.*)
    b1: u32 = @u32((buf + 1).*)
    b2: u32 = @u32((buf + 2).*)
    b3: u32 = @u32((buf + 3).*)
    ret (b0 << 24) | (b1 << 16) | (b2 << 8) | b3
}

fn chunk_type_is(buf: *u8, t0: u8, t1: u8, t2: u8, t3: u8) -> bool {
    ret buf.* == t0 && (buf+1).* == t1 && (buf+2).* == t2 && (buf+3).* == t3
}

fn paeth_predictor(a: i32, b: i32, c: i32) -> i32 {
    p: i32 = a + b - c
    pa: i32 = p - a
    if pa < 0 { pa = -pa }
    pb: i32 = p - b
    if pb < 0 { pb = -pb }
    pc: i32 = p - c
    if pc < 0 { pc = -pc }
    if pa <= pb && pa <= pc { ret a }
    if pb <= pc { ret b }
    ret c
}

# free_file: release a buffer from file.read_all. An empty result points at
# the caller's path string rather than a heap buffer, so only free real data.
fn free_file(data: str) {
    if data.len > 0 { free(data.data) }
}

fn load_png(path: str) -> !Image {
    data: str = file.read_all(path)
    defer free_file(data)
    if data.len < 8 { ret @err(1) }

    sig: *u8 = data.data
    if sig.* != 0x89u8 || (sig+1).* != 0x50u8 || (sig+2).* != 0x4eu8 || (sig+3).* != 0x47u8 {
        ret @err(1) # not a PNG (bad signature)
    }

    width: i32 = 0
    height: i32 = 0
    bit_depth: u8 = 0
    color_type: u8 = 0
    have_ihdr: bool = false

    idat: *u8 = null
    idat_len: usize = 0
    idat_cap: usize = 0

    pos: usize = 8
    done: bool = false
    while !done && pos + 8 <= data.len {
        chunk: *u8 = data.data + pos
        clen: u32 = read_be32(chunk)
        ctype: *u8 = chunk + 4
        cdata: *u8 = chunk + 8

        if chunk_type_is(ctype, 73u8, 72u8, 68u8, 82u8) { # "IHDR"
            if clen != 13 { ret @err(2) }
            width  = @i32(read_be32(cdata))
            height = @i32(read_be32(cdata + 4))
            bit_depth  = (cdata + 8).*
            color_type = (cdata + 9).*
            interlace: u8 = (cdata + 12).*
            if interlace != 0u8 { ret @err(3) } # interlaced PNG not supported
            if bit_depth != 8u8 { ret @err(3) } # only 8-bit-per-channel supported
            if color_type != 2u8 && color_type != 6u8 { ret @err(3) } # only RGB/RGBA supported
            have_ihdr = true
        } elif chunk_type_is(ctype, 73u8, 68u8, 65u8, 84u8) { # "IDAT"
            n: usize = @usize(clen)
            if idat_len + n > idat_cap {
                new_cap: usize = idat_cap * 2 + n + 4096
                idat = realloc(idat, new_cap)
                idat_cap = new_cap
            }
            memcpy(idat + idat_len, cdata, n)
            idat_len += n
        } elif chunk_type_is(ctype, 73u8, 69u8, 78u8, 68u8) { # "IEND"
            done = true
        }

        pos += 8 + @usize(clen) + 4 # length + type + data + crc
    }

    if !have_ihdr || width <= 0 || height <= 0 || idat == null {
        if idat != null { free(idat) }
        ret @err(4)
    }

    channels: i32 = if color_type == 6u8 { 4 } else { 3 }
    stride: usize = @usize(width) * @usize(channels)
    filtered_len: u64 = @u64(@usize(height) * (stride + 1))

    filtered: *u8 = malloc(@usize(filtered_len))
    inflated_len: u64 = filtered_len
    zret: i32 = uncompress(filtered, &inflated_len, idat, @u64(idat_len))
    free(idat)
    if zret != 0 || inflated_len != filtered_len {
        free(filtered)
        ret @err(5) # corrupt or truncated IDAT stream
    }

    pixels: *u8 = malloc(@usize(height) * stride)

    y: i32 = 0
    while y < height {
        row_start: usize = @usize(y) * (stride + 1)
        ftype: u8 = (filtered + row_start).*
        src: *u8 = filtered + row_start + 1
        dst: *u8 = pixels + @usize(y) * stride

        x: usize = 0
        while x < stride {
            raw: i32 = @i32((src + x).*)
            a: i32 = if x >= @usize(channels) { @i32((dst + x - @usize(channels)).*) } else { 0 }
            b: i32 = if y > 0 { @i32((dst - stride + x).*) } else { 0 }
            c: i32 = if y > 0 && x >= @usize(channels) { @i32((dst - stride + x - @usize(channels)).*) } else { 0 }

            recon: i32 = raw
            if ftype == 1u8 { recon = raw + a }
            elif ftype == 2u8 { recon = raw + b }
            elif ftype == 3u8 { recon = raw + (a + b) / 2 }
            elif ftype == 4u8 { recon = raw + paeth_predictor(a, b, c) }

            (dst + x).* = @u8(recon)
            x += 1
        }
        y += 1
    }

    free(filtered)

    img: Image = Image{.width=width, .height=height, .channels=channels, .pixels=pixels}
    ret @ok(img)
}

# ── GIF (animated) ───────────────────────────────────────────────────────────
#
# GIF87a/89a, non-interlaced only (matching PNG's precedent above of
# rejecting a scope-widening variant with a clear error rather than
# building it preemptively). Every frame is fully composited against a
# persistent canvas honoring the Graphic Control Extension's disposal
# method (0/1 leave in place, 2 restore to background, 3 restore to
# previous) and transparent color index — real animated GIFs routinely
# only redraw the changed region per frame and rely on this compositing,
# so skipping it would visibly corrupt most real-world animated GIFs, not
# just an edge case. LZW decompression (GIF's own variant — 87a/89a
# predates DEFLATE) is hand-written below; there's no system library for
# it the way zlib covers PNG's DEFLATE.

fn read_le16(buf: *u8) -> u32 {
    b0: u32 = @u32(buf.*)
    b1: u32 = @u32((buf + 1).*)
    ret b0 | (b1 << 8u32)
}

struct GifFrame {
    pixels:   *u8,   # width*height*4 bytes RGBA, row-major, top row first
    delay_ms: i32,
}

struct Gif {
    width:    i32,
    height:   i32,
    frames:   *GifFrame,
    n_frames: usize,
}

fn free_gif(g: Gif) {
    i: usize = 0
    while i < g.n_frames {
        p: *u8 = g.frames[i].pixels
        if p != null { free(p) }
        i += 1
    }
    if g.frames != null { free(@bitcast(*u8, g.frames)) }
}

# gif_decode_code: walk `code`'s dictionary chain (root codes' prefix is
# the 0xFFFF sentinel) into `stack`, in forward output order. Returns the
# byte count written. `code` must already be a defined table entry
# (caller handles the one code that legitimately isn't yet: see the
# "KwKwK" case in gif_lzw_decode).
fn gif_decode_code(code: u32, prefix: *u16, suffix: *u8, stack: *u8) -> usize {
    cur: u32 = code
    n: usize = 0
    while true {
        stack[n] = suffix[cur]
        n += 1
        p: u16 = prefix[cur]
        if p == 0xFFFFu16 { break }
        cur = @u32(p)
    }
    lo: usize = 0
    hi: usize = n - 1
    while lo < hi {
        tmp: u8 = stack[lo]
        stack[lo] = stack[hi]
        stack[hi] = tmp
        lo += 1
        hi -= 1
    }
    ret n
}

# gif_lzw_decode: decode a GIF-flavor LZW stream (already concatenated
# across its sub-block boundaries — see load_gif) into exactly
# `want_len` color-table indices, or fewer if the stream runs out first
# (a corrupt/truncated frame; callers treat a short result as an error).
fn gif_lzw_decode(data: *u8, data_len: usize, min_code_size: u32, want_len: usize) -> *u8 {
    clear_code: u32 = 1u32 << min_code_size
    end_code: u32 = clear_code + 1u32

    prefix: [4096]u16 = undef
    suffix: [4096]u8 = undef
    i: u32 = 0
    while i < clear_code {
        prefix[i] = 0xFFFFu16
        suffix[i] = @u8(i)
        i += 1
    }

    next_code: u32 = end_code + 1u32
    code_size: u32 = min_code_size + 1u32

    out: *u8 = malloc(want_len)
    out_len: usize = 0

    bitpos: usize = 0
    total_bits: usize = data_len * 8

    prev_code: u32 = 0xFFFFFFFFu32
    stack: [4096]u8 = undef

    while out_len < want_len {
        if bitpos + @usize(code_size) > total_bits { break }

        code: u32 = 0
        b: u32 = 0
        while b < code_size {
            byte_idx: usize = (bitpos + @usize(b)) / 8
            bit_idx: u32 = @u32((bitpos + @usize(b)) % 8)
            bit: u32 = (@u32((data + byte_idx).*) >> bit_idx) & 1u32
            code = code | (bit << b)
            b += 1
        }
        bitpos += @usize(code_size)

        if code == clear_code {
            next_code = end_code + 1u32
            code_size = min_code_size + 1u32
            prev_code = 0xFFFFFFFFu32
            continue
        }
        if code == end_code { break }

        n: usize = 0
        first_byte: u8 = 0
        if code < next_code {
            n = gif_decode_code(code, &prefix[0], &suffix[0], &stack[0])
            first_byte = stack[0]
        } elif code == next_code && prev_code != 0xFFFFFFFFu32 {
            # KwKwK: the one code that's legitimately not in the table
            # yet — the string this step is about to define, referenced
            # one code early. Value: previous string + its own first byte.
            n = gif_decode_code(prev_code, &prefix[0], &suffix[0], &stack[0])
            first_byte = stack[0]
            stack[n] = first_byte
            n += 1
        } else {
            break # invalid/corrupt code — stop rather than read garbage
        }

        copy_n: usize = n
        if out_len + copy_n > want_len { copy_n = want_len - out_len }
        memcpy(out + out_len, &stack[0], copy_n)
        out_len += copy_n

        if prev_code != 0xFFFFFFFFu32 && next_code < 4096u32 {
            prefix[next_code] = @u16(prev_code)
            suffix[next_code] = first_byte
            next_code += 1u32
            if next_code == (1u32 << code_size) && code_size < 12u32 {
                code_size += 1u32
            }
        }
        prev_code = code
    }

    ret out
}

fn gif_clear_region(canvas: *u8, canvas_w: i32, x: i32, y: i32, w: i32, h: i32) {
    row: i32 = 0
    while row < h {
        off: usize = (@usize(y + row) * @usize(canvas_w) + @usize(x)) * 4
        memset(canvas + off, 0, @usize(w) * 4)
        row += 1
    }
}

fn gif_copy_region(dst: *u8, src: *u8, canvas_w: i32, x: i32, y: i32, w: i32, h: i32) {
    row: i32 = 0
    while row < h {
        off: usize = (@usize(y + row) * @usize(canvas_w) + @usize(x)) * 4
        memcpy(dst + off, src + off, @usize(w) * 4)
        row += 1
    }
}

# gif_composite_frame: blend a decoded frame's color-table indices onto
# `canvas` at (x, y) — pixels matching `transparent_idx` (-1 = no
# transparency in this frame) leave the canvas pixel underneath alone,
# which is exactly what lets a small, mostly-transparent frame update
# only part of the canvas each tick.
fn gif_composite_frame(canvas: *u8, canvas_w: i32, canvas_h: i32, x: i32, y: i32, w: i32, h: i32,
                        indices: *u8, n_indices: usize, table: *u8, transparent_idx: i32) {
    row: i32 = 0
    while row < h {
        col: i32 = 0
        while col < w {
            src_i: usize = @usize(row) * @usize(w) + @usize(col)
            if src_i < n_indices {
                idx: u8 = indices[src_i]
                cx: i32 = x + col
                cy: i32 = y + row
                if @i32(idx) != transparent_idx && cx >= 0 && cy >= 0 && cx < canvas_w && cy < canvas_h {
                    dst_off: usize = (@usize(cy) * @usize(canvas_w) + @usize(cx)) * 4
                    tbl_off: usize = @usize(idx) * 3
                    (canvas + dst_off).* = (table + tbl_off).*
                    (canvas + dst_off + 1).* = (table + tbl_off + 1).*
                    (canvas + dst_off + 2).* = (table + tbl_off + 2).*
                    (canvas + dst_off + 3).* = 255u8
                }
            }
            col += 1
        }
        row += 1
    }
}

# ── Streaming GIF decoding ──────────────────────────────────────────────────
# GifDecoder keeps the file's bytes and decodes one frame at a time onto a
# single canvas, so an animation costs its file size plus two canvases,
# not width * height * 4 bytes for every frame. gdev.AnimatedSprite plays
# GIFs this way; load_gif (below) uses it to decode every frame up front.
#
#   d, err: !img.GifDecoder = img.open_gif("anim.gif")
#   delay: i32 = d.next_frame()     # composited RGBA is now in d.canvas
#   d.rewind()                       # back to frame 0
#   d.close()

struct GifDecoder {
    data:      str,     # the whole file (owned)
    width:     i32,
    height:    i32,
    n_frames:  usize,
    delays:    *i32,    # each frame's delay in ms, from the pre-scan
    canvas:    *u8,     # width * height * 4 RGBA: the current frame
    saved:     *u8,     # snapshot for disposal method 3
    gct:       *u8,     # global color table (points into data), or null
    start:     usize,   # where frame data begins
    pos:       usize,
    frame:     usize,   # index of the next frame next_frame() decodes
    # Graphic Control Extension waiting for the next image descriptor
    gce_delay_ms:        i32,
    gce_transparent_idx: i32,
    gce_disposal:        u32,
    # the previous frame's region and disposal, applied before the next
    have_prev:     bool,
    prev_disposal: u32,
    prev_x: i32,
    prev_y: i32,
    prev_w: i32,
    prev_h: i32,
}

# gif_skip_sub_blocks: advance past a run of data sub-blocks and its
# zero-length terminator
fn gif_skip_sub_blocks(data: str, pos: usize) -> usize {
    p: usize = pos
    while p < data.len {
        sz: u8 = (data.data + p).*
        p += 1
        if sz == 0u8 { break }
        p += @usize(sz)
    }
    ret p
}

# open_gif: read and validate a GIF and pre-scan its frames (count, delays).
# Errors: 1 not a GIF, 2 truncated header, 3 interlaced (unsupported),
# 4 no frames.
fn open_gif(path: str) -> !GifDecoder {
    data: str = file.read_all(path)
    if data.len < 13 {
        free_file(data)
        ret @err(1)
    }
    sig: *u8 = data.data
    is_gif: bool = sig.* == 71u8 && (sig+1).* == 73u8 && (sig+2).* == 70u8 && (sig+3).* == 56u8
        && ((sig+4).* == 55u8 || (sig+4).* == 57u8) && (sig+5).* == 97u8
    if !is_gif {
        free_file(data)
        ret @err(1) # not a GIF ("GIF87a"/"GIF89a")
    }
    width: i32  = @i32(read_le16(data.data + 6))
    height: i32 = @i32(read_le16(data.data + 8))
    if width <= 0 || height <= 0 {
        free_file(data)
        ret @err(2)
    }
    lsd_packed: u8 = (data.data + 10).*
    pos: usize = 13
    gct: *u8 = null
    if (lsd_packed & 0x80u8) != 0u8 {
        n: usize = @usize(1u32 << (@u32(lsd_packed & 0x07u8) + 1u32)) * 3
        if pos + n > data.len {
            free_file(data)
            ret @err(2)
        }
        gct = data.data + pos
        pos += n
    }

    # pre-scan: count frames, collect delays, reject interlacing
    delays_cap: usize = 16
    delays: *i32 = @alo(i32, delays_cap)
    n_frames: usize = 0
    delay: i32 = 100
    p: usize = pos
    while p < data.len {
        intro: u8 = (data.data + p).*
        if intro == 0x3Bu8 { break }
        if intro == 0x21u8 {
            if p + 2 > data.len { break }
            label: u8 = (data.data + p + 1).*
            p += 2
            if label == 0xF9u8 && p + 5 <= data.len {
                delay = @i32(read_le16(data.data + p + 2)) * 10
            }
            if label == 0x01u8 && p + 13 <= data.len { p += 13 }
            p = gif_skip_sub_blocks(data, p)
        } elif intro == 0x2Cu8 {
            if p + 10 > data.len { break }
            id_packed: u8 = (data.data + p + 9).*
            if (id_packed & 0x40u8) != 0u8 {
                @free(delays)
                free_file(data)
                ret @err(3) # interlaced GIF not supported
            }
            p += 10
            if (id_packed & 0x80u8) != 0u8 {
                p += @usize(1u32 << (@u32(id_packed & 0x07u8) + 1u32)) * 3
            }
            p += 1 # LZW minimum code size
            p = gif_skip_sub_blocks(data, p)
            if n_frames == delays_cap {
                delays_cap *= 2
                delays = @realo(delays, i32, delays_cap)
            }
            delays[n_frames] = delay
            n_frames += 1
            delay = 100
        } else {
            p += 1
        }
    }
    if n_frames == 0 {
        @free(delays)
        free_file(data)
        ret @err(4)
    }

    canvas_len: usize = @usize(width) * @usize(height) * 4
    d: GifDecoder = GifDecoder{.data = data, .width = width, .height = height,
                               .n_frames = n_frames, .delays = delays,
                               .canvas = malloc(canvas_len), .saved = malloc(canvas_len),
                               .gct = gct, .start = pos, .pos = pos, .frame = 0,
                               .gce_delay_ms = 100, .gce_transparent_idx = -1, .gce_disposal = 0,
                               .have_prev = false, .prev_disposal = 0,
                               .prev_x = 0, .prev_y = 0, .prev_w = 0, .prev_h = 0}
    memset(d.canvas, 0, canvas_len)
    ret @ok(d)
}

impl GifDecoder {
    # rewind: start again from frame 0 with a cleared canvas
    fn rewind(self: *GifDecoder) {
        memset(self.canvas, 0, @usize(self.width) * @usize(self.height) * 4)
        self.pos = self.start
        self.frame = 0
        self.gce_delay_ms = 100
        self.gce_transparent_idx = -1
        self.gce_disposal = 0
        self.have_prev = false
    }

    # next_frame: decode the next frame onto `canvas`; returns its delay in
    # ms, or -1 when there are no more frames (call rewind to loop)
    fn next_frame(self: *GifDecoder) -> i32 {
        data: str = self.data
        while self.pos < data.len {
            introducer: u8 = (data.data + self.pos).*
            if introducer == 0x3Bu8 { ret -1 } # trailer
            if introducer == 0x21u8 { # extension
                self.pos += 1
                if self.pos >= data.len { ret -1 }
                label: u8 = (data.data + self.pos).*
                self.pos += 1
                if label == 0xF9u8 && self.pos + 5 <= data.len { # Graphic Control Extension
                    gce_packed: u8 = (data.data + self.pos + 1).*
                    self.gce_disposal = @u32((gce_packed >> 2u8) & 0x07u8)
                    self.gce_delay_ms = @i32(read_le16(data.data + self.pos + 2)) * 10
                    if (gce_packed & 0x01u8) != 0u8 {
                        self.gce_transparent_idx = @i32((data.data + self.pos + 4).*)
                    } else {
                        self.gce_transparent_idx = -1
                    }
                    self.pos += 6 # block size, 4 data bytes, terminator
                } else {
                    if label == 0x01u8 && self.pos + 13 <= data.len { self.pos += 13 }
                    self.pos = gif_skip_sub_blocks(data, self.pos)
                }
                continue
            }
            if introducer != 0x2Cu8 {
                self.pos += 1 # unrecognized byte — skip rather than loop forever
                continue
            }

            # image descriptor
            self.pos += 1
            if self.pos + 9 > data.len { ret -1 }
            img_x: i32 = @i32(read_le16(data.data + self.pos))
            img_y: i32 = @i32(read_le16(data.data + self.pos + 2))
            img_w: i32 = @i32(read_le16(data.data + self.pos + 4))
            img_h: i32 = @i32(read_le16(data.data + self.pos + 6))
            id_packed: u8 = (data.data + self.pos + 8).*
            self.pos += 9
            table: *u8 = self.gct
            if (id_packed & 0x80u8) != 0u8 {
                table = data.data + self.pos
                self.pos += @usize(1u32 << (@u32(id_packed & 0x07u8) + 1u32)) * 3
            }
            if self.pos >= data.len { ret -1 }
            min_code_size: u8 = (data.data + self.pos).*
            self.pos += 1

            # gather the LZW stream across its sub-blocks
            lzw_cap: usize = 256
            lzw: *u8 = malloc(lzw_cap)
            lzw_len: usize = 0
            while self.pos < data.len {
                sz: u8 = (data.data + self.pos).*
                self.pos += 1
                if sz == 0u8 { break }
                n: usize = @usize(sz)
                if lzw_len + n > lzw_cap {
                    lzw_cap = (lzw_len + n) * 2 + 256
                    lzw = realloc(lzw, lzw_cap)
                }
                if self.pos + n > data.len { n = data.len - self.pos }
                memcpy(lzw + lzw_len, data.data + self.pos, n)
                lzw_len += n
                self.pos += n
            }

            if self.have_prev {
                if self.prev_disposal == 2u32 {
                    gif_clear_region(self.canvas, self.width, self.prev_x, self.prev_y, self.prev_w, self.prev_h)
                } elif self.prev_disposal == 3u32 {
                    gif_copy_region(self.canvas, self.saved, self.width, self.prev_x, self.prev_y, self.prev_w, self.prev_h)
                }
            }
            gif_copy_region(self.saved, self.canvas, self.width, img_x, img_y, img_w, img_h)

            idx_len: usize = @usize(img_w) * @usize(img_h)
            indices: *u8 = gif_lzw_decode(lzw, lzw_len, @u32(min_code_size), idx_len)
            free(lzw)
            if table != null {
                gif_composite_frame(self.canvas, self.width, self.height, img_x, img_y, img_w, img_h,
                                     indices, idx_len, table, self.gce_transparent_idx)
            }
            free(indices)

            delay: i32 = self.gce_delay_ms
            self.prev_disposal = self.gce_disposal
            self.prev_x = img_x
            self.prev_y = img_y
            self.prev_w = img_w
            self.prev_h = img_h
            self.have_prev = true
            self.gce_delay_ms = 100
            self.gce_transparent_idx = -1
            self.gce_disposal = 0
            self.frame += 1
            ret delay
        }
        ret -1
    }

    fn close(self: *GifDecoder) {
        free_file(self.data)
        free(self.canvas)
        free(self.saved)
        @free(self.delays)
        self.canvas = null
        self.saved = null
        self.delays = null
        self.n_frames = 0
    }
}

# load_gif: decode every frame up front into its own RGBA buffer (see
# GifDecoder to decode as you go instead). Errors as open_gif.
fn load_gif(path: str) -> !Gif {
    d, err: !GifDecoder = open_gif(path)
    if err != 0 { ret @err(err) }
    canvas_len: usize = @usize(d.width) * @usize(d.height) * 4
    frames: *GifFrame = @alo(GifFrame, d.n_frames)
    n: usize = 0
    while n < d.n_frames {
        delay: i32 = d.next_frame()
        if delay < 0 { break }
        px: *u8 = malloc(canvas_len)
        memcpy(px, d.canvas, canvas_len)
        frames[n] = GifFrame{.pixels = px, .delay_ms = delay}
        n += 1
    }
    w: i32 = d.width
    h: i32 = d.height
    d.close()
    if n == 0 {
        free(@bitcast(*u8, frames))
        ret @err(4)
    }
    ret @ok(Gif{.width = w, .height = h, .frames = frames, .n_frames = n})
}
