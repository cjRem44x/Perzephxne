# std/os — process and environment operations

extern fn exit(code: i32)
extern fn getenv(name: *u8) -> *u8
extern fn system(cmd: *u8) -> i32
extern fn malloc(n: usize) -> *u8
extern fn free(p: *u8)
extern fn strlen(s: *u8) -> usize
extern fn getcwd(buf: *u8, size: usize) -> *u8
extern fn mkdir(path: *u8, mode: u32) -> i32
extern fn chdir(path: *u8) -> i32
extern fn rmdir(path: *u8) -> i32
extern fn stat(path: *u8, buf: *u8) -> i32
extern fn nanosleep(req: *u8, rem: *u8) -> i32
extern fn clock_gettime(clk_id: i32, tp: *u8) -> i32

S_IFMT:  u32 = 0xF000
S_IFDIR: u32 = 0x4000

# struct timespec { i64 tv_sec; i64 tv_nsec; } — checked against a real
# offsetof compile (glibc, x86-64 Linux): sizeof 16, tv_sec at byte
# offset 0, tv_nsec at offset 8 — same discipline std/file.przp's
# `struct stat` uses.
CLOCK_MONOTONIC: i32 : 1

# exit with a status code
fn quit(code: i32) {
    exit(code)
}

# getenv_str: look up an environment variable; returns empty str if not set
fn getenv_str(name: str) -> str {
    val: *u8 = getenv(name.data)
    if val == null { ret @str_raw(name.data, 0) }
    n: usize = strlen(val)
    ret @str_raw(val, n)
}

# run: execute a shell command, return exit status
fn run(cmd: str) -> i32 {
    ret system(cmd.data)
}

# cwd: return the current working directory as a str (heap-allocated)
fn cwd() -> str {
    buf: *u8 = malloc(4096)
    got: *u8 = getcwd(buf, 4096)
    if got == null { ret @str_raw(buf, 0) }
    n: usize = strlen(buf)
    ret @str_raw(buf, n)
}

# is_dir: true if path exists and is a directory. Duplicated here (rather
# than importing std/file, which already imports std/os) to avoid an
# import cycle — same "checked against a real offsetof compile, not
# guessed" st_mode-at-byte-24 read std/file.stat_mode uses.
fn is_dir(path: str) -> bool {
    buf: [144]u8 = undef
    ok: i32 = stat(path.data, &buf[0])
    if ok != 0 { ret false }
    p: *u32 = &buf[0] + 24
    ret (p.* & S_IFMT) == S_IFDIR
}

# mkdir_p: create a directory with rwxr-xr-x permissions; returns true on
# success, or if it already exists as a directory (mkdir() itself fails
# with EEXIST in that case — checking is_dir first, rather than reading
# errno, since there's no errno-reading idiom at this level yet).
fn mkdir_dir(path: str) -> bool {
    if is_dir(path) { ret true }
    ret mkdir(path.data, 493u32) == 0
}

# chdir_to: change the working directory; returns true on success
fn chdir_to(path: str) -> bool {
    ret chdir(path.data) == 0
}

# rmdir_dir: remove an empty directory; returns true on success
fn rmdir_dir(path: str) -> bool {
    ret rmdir(path.data) == 0
}

# monotonic_ms: current reading of the monotonic clock, in milliseconds.
# Only meaningful as a difference between two calls, never as a wall-clock
# timestamp.
fn monotonic_ms() -> i64 {
    ts: [16]u8 = undef
    clock_gettime(CLOCK_MONOTONIC, &ts[0])
    sec_p: *i64 = @bitcast(*i64, &ts[0])
    nsec_p: *i64 = @bitcast(*i64, &ts[0] + 8)
    ret sec_p.* * 1000 + nsec_p.* / 1000000
}

# sleep_ms: block the calling thread for at least `ms` milliseconds,
# yielding the CPU to the scheduler (a real OS sleep via nanosleep) —
# contrast with waste_ms, which burns the full duration busy-looping.
fn sleep_ms(ms: i64) {
    ts: [16]u8 = undef
    sec_p: *i64 = @bitcast(*i64, &ts[0])
    nsec_p: *i64 = @bitcast(*i64, &ts[0] + 8)
    sec_p.* = ms / 1000
    nsec_p.* = (ms % 1000) * 1000000
    nanosleep(&ts[0], null)
}

# waste_ms: spend at least `ms` milliseconds spinning on the calling
# thread — no syscall blocks it, so the CPU stays pegged for the whole
# duration. Useful for busy-wait benchmarking; sleep_ms is what you want
# for anything that should actually yield.
fn waste_ms(ms: i64) {
    start: i64 = monotonic_ms()
    while monotonic_ms() - start < ms {}
}

