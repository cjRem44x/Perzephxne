# std/audio — MP3 decoding (libmpg123) and PCM playback (ALSA). Both are
# system libraries every mainstream Linux desktop/server ships (see
# [build].link in book/build-system.md) — no hand-written MP3 decoder or
# audio driver, same reasoning as PNG's zlib dependency in std/image.
#
# Playback goes straight to ALSA's PCM API rather than a higher-level
# sound-server abstraction (PulseAudio/PipeWire) — both of those still
# expose an ALSA-compatible PCM device on any system that has them, so
# there's nothing an extra layer would add here.

extern fn malloc(n: usize) -> *u8
extern fn realloc(p: *u8, n: usize) -> *u8
extern fn free(p: *u8)
extern fn memcpy(dst: *u8, src: *u8, n: usize) -> *u8

extern fn mpg123_init() -> i32
extern fn mpg123_new(decoder: *u8, err: *i32) -> *u8
extern fn mpg123_delete(mh: *u8)
extern fn mpg123_open(mh: *u8, path: *u8) -> i32
extern fn mpg123_close(mh: *u8) -> i32
extern fn mpg123_format_none(mh: *u8) -> i32
extern fn mpg123_format(mh: *u8, rate: i64, channels: i32, encodings: i32) -> i32
extern fn mpg123_getformat(mh: *u8, rate: *i64, channels: *i32, encoding: *i32) -> i32
extern fn mpg123_read(mh: *u8, outmemory: *u8, outmemsize: usize, done: *usize) -> i32

MPG123_OK:         i32 = 0
MPG123_DONE:       i32 = -12
MPG123_NEW_FORMAT: i32 = -11
MPG123_ENC_SIGNED_16: i32 = 0xD0

extern fn snd_pcm_open(pcm: **u8, name: *u8, stream: i32, mode: i32) -> i32
extern fn snd_pcm_close(pcm: *u8) -> i32
extern fn snd_pcm_set_params(pcm: *u8, format: i32, access: i32, channels: u32, rate: u32, soft_resample: i32, latency: u32) -> i32
extern fn snd_pcm_writei(pcm: *u8, buffer: *u8, size: u64) -> i64
extern fn snd_pcm_drain(pcm: *u8) -> i32
extern fn snd_pcm_recover(pcm: *u8, err: i32, silent: i32) -> i32

extern fn pthread_create(thread: *u64, attr: *u8, start_routine: fn(*u8) -> *u8, arg: *u8) -> i32
extern fn pthread_join(thread: u64, retval: *u8) -> i32

import(os   = "std/os")
import(sync = "std/sync")

SND_PCM_STREAM_PLAYBACK:      i32 = 0
SND_PCM_FORMAT_S16_LE:        i32 = 2
SND_PCM_ACCESS_RW_INTERLEAVED: i32 = 3

# Sound: fully decoded PCM, signed 16-bit little-endian, interleaved
# channels — the format both mpg123_format() forces on decode and ALSA's
# writei expects, so no per-sample conversion sits between the two.
struct Sound {
    pcm:      *u8,   # n_frames * channels * 2 bytes
    n_frames: usize,
    channels: i32,
    rate:     i32,
}

fn free_sound(s: Sound) {
    if s.pcm != null { free(s.pcm) }
}

# decode_mp3: fully decodes an MP3 file into memory as signed 16-bit PCM.
# Fine for the short sound effects/music loops 2D games actually use —
# streaming decode during playback is a straightforward extension of the
# same mpg123_read loop if a future caller ever needs it for long tracks.
fn decode_mp3(path: str) -> !Sound {
    mpg123_init()

    err: i32 = 0
    mh: *u8 = mpg123_new(null, &err)
    if mh == null { ret @err(1) }

    if mpg123_open(mh, path.data) != MPG123_OK {
        mpg123_delete(mh)
        ret @err(2)
    }

    rate: i64 = 0
    channels: i32 = 0
    encoding: i32 = 0
    if mpg123_getformat(mh, &rate, &channels, &encoding) != MPG123_OK {
        mpg123_close(mh)
        mpg123_delete(mh)
        ret @err(3)
    }
    mpg123_format_none(mh)
    mpg123_format(mh, rate, channels, MPG123_ENC_SIGNED_16)

    cap: usize = 1048576
    buf: *u8 = @alo(u8, cap)
    len: usize = 0

    chunk_cap: usize = 65536
    chunk: *u8 = @alo(u8, chunk_cap)

    done: bool = false
    while !done {
        got: usize = 0
        r: i32 = mpg123_read(mh, chunk, chunk_cap, &got)
        if got > 0 {
            if len + got > cap {
                while len + got > cap { cap = cap * 2 }
                buf = @realo(buf, u8, cap)
            }
            memcpy(buf + len, chunk, got)
            len += got
        }
        if r == MPG123_NEW_FORMAT {
            mpg123_getformat(mh, &rate, &channels, &encoding)
        } elif r != MPG123_OK {
            done = true # MPG123_DONE, or any error — either way, stop
        }
    }

    free(chunk)
    mpg123_close(mh)
    mpg123_delete(mh)

    bytes_per_frame: usize = @usize(channels) * 2
    n_frames: usize = len / bytes_per_frame

    ret Sound{.pcm=buf, .n_frames=n_frames, .channels=channels, .rate=@i32(rate)}
}

# AUDIO_QUEUE_CAP: how many play_sound() requests can be pending for the
# background audio thread at once — headroom well beyond what a 2D game's
# rapid-fire SFX realistically queues between two drains of the ALSA
# buffer; a request that finds the queue full just drops that one shot's
# sound rather than ever making the caller wait, the same fixed-capacity
# tradeoff MAX_BULLETS makes in examples/games/astro_blaster.
AUDIO_QUEUE_CAP: usize : 16

struct AudioRequest {
    pcm:      *u8,
    n_frames: usize,
}

# AudioCtrl: the state shared between a caller's thread and the
# background audio thread — always accessed through a pointer (see
# AudioOutput.ctrl) so every AudioOutput copy still refers to the same
# queue, mutex, and PCM handle. `running=false` plus an empty queue is
# the worker's exit signal (see close_output/audio_worker).
struct AudioCtrl {
    mu:              sync.Mutex,
    pcm:             *u8,
    bytes_per_frame: usize,
    thread:          u64,
    queue:           [AUDIO_QUEUE_CAP]AudioRequest,
    head:            usize,
    count:           usize,
    running:         bool,
}

# audio_worker: runs on its own thread for the lifetime of an
# AudioOutput. Blocks freely on snd_pcm_writei — that's the whole point:
# a game's single-threaded render loop calls play_sound() to enqueue a
# request (a mutex-guarded pointer/length copy, never touches ALSA) and
# carries on immediately, no matter how slowly the ALSA backend the
# system resolves "default" to actually services a write. Some ALSA PCM
# plugins — PulseAudio's/PipeWire's ALSA-compat shim especially, common
# on desktop Linux — have historically not honored SND_PCM_NONBLOCK
# cheaply (or at all) on every write, which was the working theory
# behind this rewrite (a stutter reported against
# examples/games/astro_blaster, worse holding fire down). It turned out
# not to be the cause — the same stutter reproduces with audio skipped
# entirely (`przp run --no-audio`) — but moving playback off the render
# thread is still the right design regardless of what "default"
# resolves to, so it stays; the actual stutter is still open, see
# astro_blaster's main.przp for the frame-stall diagnostic tracking it.
fn audio_worker(arg: *u8) -> *u8 {
    ctrl: *AudioCtrl = arg
    while true {
        sync.lock(&ctrl.mu)
        if ctrl.count == 0 {
            still_running: bool = ctrl.running
            sync.unlock(&ctrl.mu)
            if !still_running { ret null }
            os.sleep_ms(2)
            continue
        }
        req: AudioRequest = ctrl.queue[ctrl.head]
        ctrl.head = (ctrl.head + 1) % AUDIO_QUEUE_CAP
        ctrl.count -= 1
        sync.unlock(&ctrl.mu)

        buf: *u8 = req.pcm
        frames_left: usize = req.n_frames
        while frames_left > 0 {
            r: i64 = snd_pcm_writei(ctrl.pcm, buf, @u64(frames_left))
            if r < 0 {
                if snd_pcm_recover(ctrl.pcm, @i32(r), 1) != 0 { break }
                continue
            }
            written: usize = @usize(r)
            if written == 0 { break }
            frames_left -= written
            buf = buf + written * ctrl.bytes_per_frame
        }
    }
    ret null
}

# AudioOutput: an open ALSA PCM playback handle plus its background
# playback thread. `device` is an ALSA PCM name — "default" for the
# system's default output, "null" for ALSA's hardware-free sink (useful
# for testing FFI plumbing on a machine with no real sound card, the same
# role Xvfb plays for std/graphics/gl).
struct AudioOutput {
    channels: i32,
    ctrl:     *AudioCtrl,
}

fn open_output(device: str, rate: i32, channels: i32) -> !AudioOutput {
    pcm: *u8 = null
    if snd_pcm_open(&pcm, device.data, SND_PCM_STREAM_PLAYBACK, 0) < 0 {
        ret @err(1)
    }
    if snd_pcm_set_params(pcm, SND_PCM_FORMAT_S16_LE, SND_PCM_ACCESS_RW_INTERLEAVED,
            @u32(channels), @u32(rate), 1, 500000u32) < 0 {
        snd_pcm_close(pcm)
        ret @err(2)
    }

    ctrl: *AudioCtrl = @alo(AudioCtrl)
    ctrl.mu = sync.mutex_new()
    ctrl.pcm = pcm
    ctrl.bytes_per_frame = @usize(channels) * 2
    ctrl.head = 0
    ctrl.count = 0
    ctrl.running = true

    tid: u64 = 0
    if pthread_create(&tid, null, audio_worker, ctrl) != 0 {
        sync.mutex_destroy(&ctrl.mu)
        free(ctrl)
        snd_pcm_close(pcm)
        ret @err(3)
    }
    ctrl.thread = tid

    ret AudioOutput{.channels=channels, .ctrl=ctrl}
}

# play_sound: hands `s` off to the background audio thread and returns
# immediately — never calls into ALSA itself, so it never stalls the
# caller no matter how the underlying PCM device behaves. Returns the
# frame count enqueued, or 0 if the queue was full (dropped, see
# AUDIO_QUEUE_CAP) — either way the caller's frame time is unaffected.
fn play_sound(out: AudioOutput, s: Sound) -> i64 {
    ctrl: *AudioCtrl = out.ctrl
    sync.lock(&ctrl.mu)
    if ctrl.count >= AUDIO_QUEUE_CAP {
        sync.unlock(&ctrl.mu)
        ret 0
    }
    tail: usize = (ctrl.head + ctrl.count) % AUDIO_QUEUE_CAP
    ctrl.queue[tail] = AudioRequest{.pcm=s.pcm, .n_frames=s.n_frames}
    ctrl.count += 1
    sync.unlock(&ctrl.mu)
    ret @i64(s.n_frames)
}

# close_output: signals the worker to stop once its queue drains, joins
# it (bounded — the worker only blocks inside ALSA calls that themselves
# complete), then drains the PCM device and closes it. Joining first
# guarantees the worker is done touching `pcm` before this thread closes
# it out from under it.
fn close_output(out: AudioOutput) {
    ctrl: *AudioCtrl = out.ctrl
    sync.lock(&ctrl.mu)
    ctrl.running = false
    sync.unlock(&ctrl.mu)

    pthread_join(ctrl.thread, null)
    snd_pcm_drain(ctrl.pcm)
    snd_pcm_close(ctrl.pcm)
    sync.mutex_destroy(&ctrl.mu)
    free(ctrl)
}
