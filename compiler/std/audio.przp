# std/audio — MP3 decoding (libmpg123) and PCM playback (ALSA). Both are
# system libraries every mainstream Linux desktop/server ships (see
# [build].link in book/build-system.md) — no hand-written MP3 decoder or
# audio driver, same reasoning as PNG's zlib dependency in std/image.
#
# Playback goes straight to ALSA's PCM API rather than a higher-level
# sound-server abstraction (PulseAudio/PipeWire) — both of those still
# expose an ALSA-compatible PCM device on any system that has them, so
# there's nothing an extra layer would add here.

extern fn malloc(n: usize) -> *u8
extern fn realloc(p: *u8, n: usize) -> *u8
extern fn free(p: *u8)
extern fn memcpy(dst: *u8, src: *u8, n: usize) -> *u8

extern fn mpg123_init() -> i32
extern fn mpg123_new(decoder: *u8, err: *i32) -> *u8
extern fn mpg123_delete(mh: *u8)
extern fn mpg123_open(mh: *u8, path: *u8) -> i32
extern fn mpg123_close(mh: *u8) -> i32
extern fn mpg123_format_none(mh: *u8) -> i32
extern fn mpg123_format(mh: *u8, rate: i64, channels: i32, encodings: i32) -> i32
extern fn mpg123_getformat(mh: *u8, rate: *i64, channels: *i32, encoding: *i32) -> i32
extern fn mpg123_read(mh: *u8, outmemory: *u8, outmemsize: usize, done: *usize) -> i32

MPG123_OK:         i32 = 0
MPG123_DONE:       i32 = -12
MPG123_NEW_FORMAT: i32 = -11
MPG123_ENC_SIGNED_16: i32 = 0xD0

extern fn snd_pcm_open(pcm: **u8, name: *u8, stream: i32, mode: i32) -> i32
extern fn snd_pcm_close(pcm: *u8) -> i32
extern fn snd_pcm_set_params(pcm: *u8, format: i32, access: i32, channels: u32, rate: u32, soft_resample: i32, latency: u32) -> i32
extern fn snd_pcm_writei(pcm: *u8, buffer: *u8, size: u64) -> i64
extern fn snd_pcm_drain(pcm: *u8) -> i32
extern fn snd_pcm_recover(pcm: *u8, err: i32, silent: i32) -> i32
extern fn snd_pcm_drop(pcm: *u8) -> i32
extern fn snd_pcm_prepare(pcm: *u8) -> i32

extern fn pthread_create(thread: *u64, attr: *u8, start_routine: fn(*u8) -> *u8, arg: *u8) -> i32
extern fn pthread_join(thread: u64, retval: *u8) -> i32

import(os   = "std/os")
import(sync = "std/sync")

SND_PCM_STREAM_PLAYBACK:      i32 = 0
SND_PCM_FORMAT_S16_LE:        i32 = 2
SND_PCM_ACCESS_RW_INTERLEAVED: i32 = 3

# Sound: fully decoded PCM, signed 16-bit little-endian, interleaved
# channels — the format both mpg123_format() forces on decode and ALSA's
# writei expects, so no per-sample conversion sits between the two.
struct Sound {
    pcm:      *u8,   # n_frames * channels * 2 bytes
    n_frames: usize,
    channels: i32,
    rate:     i32,
}

fn free_sound(s: Sound) {
    if s.pcm != null { free(s.pcm) }
}

# decode_mp3: fully decodes an MP3 file into memory as signed 16-bit PCM.
# Fine for the short sound effects/music loops 2D games actually use —
# streaming decode during playback is a straightforward extension of the
# same mpg123_read loop if a future caller ever needs it for long tracks.
fn decode_mp3(path: str) -> !Sound {
    mpg123_init()

    err: i32 = 0
    mh: *u8 = mpg123_new(null, &err)
    if mh == null { ret @err(1) }

    if mpg123_open(mh, path.data) != MPG123_OK {
        mpg123_delete(mh)
        ret @err(2)
    }

    rate: i64 = 0
    channels: i32 = 0
    encoding: i32 = 0
    if mpg123_getformat(mh, &rate, &channels, &encoding) != MPG123_OK {
        mpg123_close(mh)
        mpg123_delete(mh)
        ret @err(3)
    }
    mpg123_format_none(mh)
    mpg123_format(mh, rate, channels, MPG123_ENC_SIGNED_16)

    cap: usize = 1048576
    buf: *u8 = @alo(u8, cap)
    len: usize = 0

    chunk_cap: usize = 65536
    chunk: *u8 = @alo(u8, chunk_cap)

    done: bool = false
    while !done {
        got: usize = 0
        r: i32 = mpg123_read(mh, chunk, chunk_cap, &got)
        if got > 0 {
            if len + got > cap {
                while len + got > cap { cap = cap * 2 }
                buf = @realo(buf, u8, cap)
            }
            memcpy(buf + len, chunk, got)
            len += got
        }
        if r == MPG123_NEW_FORMAT {
            mpg123_getformat(mh, &rate, &channels, &encoding)
        } elif r != MPG123_OK {
            done = true # MPG123_DONE, or any error — either way, stop
        }
    }

    free(chunk)
    mpg123_close(mh)
    mpg123_delete(mh)

    bytes_per_frame: usize = @usize(channels) * 2
    n_frames: usize = len / bytes_per_frame

    ret Sound{.pcm=buf, .n_frames=n_frames, .channels=channels, .rate=@i32(rate)}
}

# ── Mixer ─────────────────────────────────────────────────────────────────────
# An AudioOutput mixes up to AUDIO_MAX_VOICES sounds at once: voice 0 is
# reserved for music (play_music, optionally looping), the rest for
# one-shot effects (play_sound). Every chunk, each playing voice is
# converted to the output's channel count and sample rate, scaled by its
# own volume, summed, scaled by the master volume, and clamped to 16 bits.
#
# A background thread does the mixing and the (blocking) ALSA writes, so
# none of these calls ever stall the caller's frame loop.

AUDIO_MAX_VOICES: usize : 16
AUDIO_MUSIC_VOICE: usize : 0

# AUDIO_MIX_FRAMES: frames mixed and written per chunk (~23ms at 44.1kHz):
# how quickly a newly started sound joins the mix
AUDIO_MIX_FRAMES: usize : 1024

struct Voice {
    pcm:      *u8      # the Sound's interleaved s16 PCM (not owned)
    n_frames: usize
    channels: i32
    pos:      u64      # read position in source frames, 16.16 fixed point
    step:     u64      # source frames per output frame, 16.16 (rate conversion)
    volume:   f32
    looping:  bool
    active:   bool
}

struct AudioCtrl {
    mu:              sync.Mutex,
    pcm:             *u8,       # ALSA handle; null for an offline output
    channels:        i32,
    rate:            i32,
    bytes_per_frame: usize,
    thread:          u64,
    voices:          [16]Voice,
    running:         bool,
    paused:          bool,
    stop_requested:  bool,
    volume:          f32,       # master volume
    music_volume:    f32,
    mix:             *i32,      # accumulator, AUDIO_MIX_FRAMES * channels
    scratch:         *u8,       # mixed s16 output, AUDIO_MIX_FRAMES frames
}

# mix_chunk: mix `frames` output frames from every active voice into
# ctrl.scratch (s16, interleaved), advancing and retiring voices. Caller
# holds ctrl.mu.
fn mix_chunk(ctrl: *AudioCtrl, frames: usize) {
    out_ch: usize = @usize(ctrl.channels)
    n: usize = frames * out_ch
    for i => 0..n { ctrl.mix[i] = 0 }
    for v => 0..AUDIO_MAX_VOICES {
        if !ctrl.voices[v].active { continue }
        src: *i16 = @bitcast(*i16, ctrl.voices[v].pcm)
        src_ch: usize = @usize(ctrl.voices[v].channels)
        total: u64 = @u64(ctrl.voices[v].n_frames)
        pos: u64 = ctrl.voices[v].pos
        step: u64 = ctrl.voices[v].step
        vol: f32 = ctrl.voices[v].volume
        f: usize = 0
        while f < frames {
            sf: u64 = pos >> 16
            if sf >= total {
                if !ctrl.voices[v].looping || total == 0 {
                    ctrl.voices[v].active = false
                    break
                }
                pos = pos - (total << 16)
                sf = pos >> 16
            }
            base: usize = @usize(sf) * src_ch
            if out_ch == src_ch {
                for c => 0..out_ch {
                    ctrl.mix[f * out_ch + c] += @i32(@f32(src[base + c]) * vol)
                }
            } elif src_ch == 1 {
                m: i32 = @i32(@f32(src[base]) * vol)
                for c2 => 0..out_ch { ctrl.mix[f * out_ch + c2] += m }
            } else {
                # downmix: average the source channels into each output channel
                sum: i32 = 0
                for c3 => 0..src_ch { sum += @i32(src[base + c3]) }
                avg: i32 = @i32(@f32(sum / @i32(src_ch)) * vol)
                for c4 => 0..out_ch { ctrl.mix[f * out_ch + c4] += avg }
            }
            pos += step
            f += 1
        }
        ctrl.voices[v].pos = pos
    }
    out16: *i16 = @bitcast(*i16, ctrl.scratch)
    master: f32 = ctrl.volume
    for j => 0..n {
        x: f32 = @f32(ctrl.mix[j]) * master
        if x > 32767.0 { x = 32767.0 }
        if x < -32768.0 { x = -32768.0 }
        out16[j] = @i16(x)
    }
}

fn any_active(ctrl: *AudioCtrl) -> bool {
    for v => 0..AUDIO_MAX_VOICES {
        if ctrl.voices[v].active { ret true }
    }
    ret false
}

fn audio_worker(arg: *u8) -> *u8 {
    ctrl: *AudioCtrl = arg
    while true {
        sync.lock(&ctrl.mu)
        if ctrl.stop_requested {
            for v => 0..AUDIO_MAX_VOICES { ctrl.voices[v].active = false }
            ctrl.stop_requested = false
            sync.unlock(&ctrl.mu)
            snd_pcm_drop(ctrl.pcm)
            snd_pcm_prepare(ctrl.pcm)
            continue
        }
        active: bool = any_active(ctrl)
        if !ctrl.running && (!active || ctrl.paused) {
            sync.unlock(&ctrl.mu)
            ret null
        }
        if ctrl.paused || !active {
            sync.unlock(&ctrl.mu)
            os.sleep_ms(2)
            continue
        }
        mix_chunk(ctrl, AUDIO_MIX_FRAMES)
        sync.unlock(&ctrl.mu)

        # blocking write outside the lock, so play_sound never waits on ALSA
        buf: *u8 = ctrl.scratch
        left: usize = AUDIO_MIX_FRAMES
        while left > 0 {
            r: i64 = snd_pcm_writei(ctrl.pcm, buf, @u64(left))
            if r < 0 {
                if snd_pcm_recover(ctrl.pcm, @i32(r), 1) != 0 { break }
                continue
            }
            if r == 0 { break }
            left -= @usize(r)
            buf = buf + @usize(r) * ctrl.bytes_per_frame
        }
    }
    ret null
}

# AudioOutput: an open playback device and its mixer. `device` is an ALSA
# PCM name — "default" for the system's default output, "null" for ALSA's
# hardware-free sink (useful on a machine with no sound card, the same role
# Xvfb plays for std/graphics).
struct AudioOutput {
    channels: i32,
    ctrl:     *AudioCtrl,
}

fn new_ctrl(rate: i32, channels: i32) -> *AudioCtrl {
    ctrl: *AudioCtrl = @alo(AudioCtrl)
    ctrl.mu = sync.mutex_new()
    ctrl.pcm = null
    ctrl.channels = channels
    ctrl.rate = rate
    ctrl.bytes_per_frame = @usize(channels) * 2
    for v => 0..AUDIO_MAX_VOICES { ctrl.voices[v].active = false }
    ctrl.running = true
    ctrl.paused = false
    ctrl.stop_requested = false
    ctrl.volume = 1.0
    ctrl.music_volume = 1.0
    ctrl.mix = @alo(i32, AUDIO_MIX_FRAMES * @usize(channels))
    ctrl.scratch = @alo(u8, AUDIO_MIX_FRAMES * ctrl.bytes_per_frame)
    ret ctrl
}

fn free_ctrl(ctrl: *AudioCtrl) {
    sync.mutex_destroy(&ctrl.mu)
    free(@bitcast(*u8, ctrl.mix))
    free(ctrl.scratch)
    free(@bitcast(*u8, ctrl))
}

# open_output: open `device` at `rate` Hz with `channels` channels (2 for
# stereo). Sounds in any rate/channel layout can be played on it.
# Errors: 1 can't open the device, 2 format rejected, 3 thread failed.
fn open_output(device: str, rate: i32, channels: i32) -> !AudioOutput {
    pcm: *u8 = null
    if snd_pcm_open(&pcm, device.data, SND_PCM_STREAM_PLAYBACK, 0) < 0 {
        ret @err(1)
    }
    if snd_pcm_set_params(pcm, SND_PCM_FORMAT_S16_LE, SND_PCM_ACCESS_RW_INTERLEAVED,
            @u32(channels), @u32(rate), 1, 100000u32) < 0 {
        snd_pcm_close(pcm)
        ret @err(2)
    }
    ctrl: *AudioCtrl = new_ctrl(rate, channels)
    ctrl.pcm = pcm
    tid: u64 = 0
    if pthread_create(&tid, null, audio_worker, @bitcast(*u8, ctrl)) != 0 {
        free_ctrl(ctrl)
        snd_pcm_close(pcm)
        ret @err(3)
    }
    ctrl.thread = tid
    ret AudioOutput{.channels=channels, .ctrl=ctrl}
}

# open_offline: a mixer with no device or thread — render_offline pulls
# mixed audio from it directly. For tests, or writing audio to a file.
fn open_offline(rate: i32, channels: i32) -> AudioOutput {
    ctrl: *AudioCtrl = new_ctrl(rate, channels)
    ctrl.running = false
    ret AudioOutput{.channels=channels, .ctrl=ctrl}
}

# render_offline: mix the next `frames` frames (at most AUDIO_MIX_FRAMES)
# of an open_offline output; returns interleaved samples valid until the
# next call
fn render_offline(out: AudioOutput, frames: usize) -> *i16 {
    n: usize = frames
    if n > AUDIO_MIX_FRAMES { n = AUDIO_MIX_FRAMES }
    ctrl: *AudioCtrl = out.ctrl
    sync.lock(&ctrl.mu)
    mix_chunk(ctrl, n)
    sync.unlock(&ctrl.mu)
    ret @bitcast(*i16, ctrl.scratch)
}

fn start_voice(ctrl: *AudioCtrl, v: usize, s: Sound, vol: f32, looping: bool) {
    ctrl.voices[v] = Voice{.pcm = s.pcm, .n_frames = s.n_frames, .channels = s.channels,
                           .pos = 0, .step = (@u64(s.rate) << 16) / @u64(ctrl.rate),
                           .volume = vol, .looping = looping, .active = true}
}

# play_sound: start `s` as a one-shot effect, mixed with whatever else is
# playing. Returns its frame count, or 0 if every effect voice is busy (the
# sound is skipped — the caller never waits). `s` must stay alive while it
# plays.
fn play_sound(out: AudioOutput, s: Sound) -> i64 {
    ctrl: *AudioCtrl = out.ctrl
    sync.lock(&ctrl.mu)
    for v => 1..AUDIO_MAX_VOICES {
        if !ctrl.voices[v].active {
            start_voice(ctrl, v, s, 1.0, false)
            sync.unlock(&ctrl.mu)
            ret @i64(s.n_frames)
        }
    }
    sync.unlock(&ctrl.mu)
    ret 0
}

# play_music: play `s` on the music voice, replacing any current music;
# `looping` restarts it seamlessly at the end
fn play_music(out: AudioOutput, s: Sound, looping: bool) {
    ctrl: *AudioCtrl = out.ctrl
    sync.lock(&ctrl.mu)
    start_voice(ctrl, AUDIO_MUSIC_VOICE, s, ctrl.music_volume, looping)
    sync.unlock(&ctrl.mu)
}

fn stop_music(out: AudioOutput) {
    ctrl: *AudioCtrl = out.ctrl
    sync.lock(&ctrl.mu)
    ctrl.voices[AUDIO_MUSIC_VOICE].active = false
    sync.unlock(&ctrl.mu)
}

fn is_music_playing(out: AudioOutput) -> bool {
    ctrl: *AudioCtrl = out.ctrl
    sync.lock(&ctrl.mu)
    p: bool = ctrl.voices[AUDIO_MUSIC_VOICE].active
    sync.unlock(&ctrl.mu)
    ret p
}

# set_music_volume: the music voice's own volume (1.0 = unchanged), on top
# of the master volume — e.g. duck the music under dialogue
fn set_music_volume(out: AudioOutput, vol: f32) {
    v: f32 = vol
    if v < 0.0 { v = 0.0 }
    ctrl: *AudioCtrl = out.ctrl
    sync.lock(&ctrl.mu)
    ctrl.music_volume = v
    ctrl.voices[AUDIO_MUSIC_VOICE].volume = v
    sync.unlock(&ctrl.mu)
}

# sounds_playing: how many voices (music included) are playing right now
fn sounds_playing(out: AudioOutput) -> i32 {
    ctrl: *AudioCtrl = out.ctrl
    sync.lock(&ctrl.mu)
    n: i32 = 0
    for v => 0..AUDIO_MAX_VOICES {
        if ctrl.voices[v].active { n += 1 }
    }
    sync.unlock(&ctrl.mu)
    ret n
}

# pause_output/resume_output: stop/resume mixing. Whatever is already in
# the device's buffer (~100ms) plays out; resuming continues every voice
# exactly where it left off.
fn pause_output(out: AudioOutput) {
    ctrl: *AudioCtrl = out.ctrl
    sync.lock(&ctrl.mu)
    ctrl.paused = true
    sync.unlock(&ctrl.mu)
}

fn resume_output(out: AudioOutput) {
    ctrl: *AudioCtrl = out.ctrl
    sync.lock(&ctrl.mu)
    ctrl.paused = false
    sync.unlock(&ctrl.mu)
}

fn is_paused(out: AudioOutput) -> bool {
    ctrl: *AudioCtrl = out.ctrl
    sync.lock(&ctrl.mu)
    p: bool = ctrl.paused
    sync.unlock(&ctrl.mu)
    ret p
}

# stop_output: silence everything now — every voice (music included) is
# stopped and the device's buffer is discarded
fn stop_output(out: AudioOutput) {
    ctrl: *AudioCtrl = out.ctrl
    sync.lock(&ctrl.mu)
    if ctrl.pcm == null {
        for v => 0..AUDIO_MAX_VOICES { ctrl.voices[v].active = false }
    } else {
        ctrl.stop_requested = true
    }
    sync.unlock(&ctrl.mu)
}

# set_volume: master volume for everything (1.0 = unchanged, 0.0 = silent,
# >1.0 boosts and may clip). Negative values clamp to 0.0.
fn set_volume(out: AudioOutput, vol: f32) {
    v: f32 = vol
    if v < 0.0 { v = 0.0 }
    ctrl: *AudioCtrl = out.ctrl
    sync.lock(&ctrl.mu)
    ctrl.volume = v
    sync.unlock(&ctrl.mu)
}

# close_output: stop the music, let effects already playing finish, then
# shut the device down. Safe to call while paused.
fn close_output(out: AudioOutput) {
    ctrl: *AudioCtrl = out.ctrl
    sync.lock(&ctrl.mu)
    ctrl.voices[AUDIO_MUSIC_VOICE].active = false
    was_running: bool = ctrl.running
    ctrl.running = false
    ctrl.paused = false
    sync.unlock(&ctrl.mu)
    if ctrl.pcm != null {
        if was_running { pthread_join(ctrl.thread, null) }
        snd_pcm_drain(ctrl.pcm)
        snd_pcm_close(ctrl.pcm)
    }
    free_ctrl(ctrl)
}
