# std/audio — MP3 decoding (libmpg123) and PCM playback (ALSA). Both are
# system libraries every mainstream Linux desktop/server ships (see
# [build].link in book/build-system.md) — no hand-written MP3 decoder or
# audio driver, same reasoning as PNG's zlib dependency in std/image.
#
# Playback goes straight to ALSA's PCM API rather than a higher-level
# sound-server abstraction (PulseAudio/PipeWire) — both of those still
# expose an ALSA-compatible PCM device on any system that has them, so
# there's nothing an extra layer would add here.

extern fn malloc(n: usize) -> *u8
extern fn realloc(p: *u8, n: usize) -> *u8
extern fn free(p: *u8)
extern fn memcpy(dst: *u8, src: *u8, n: usize) -> *u8

extern fn mpg123_init() -> i32
extern fn mpg123_new(decoder: *u8, err: *i32) -> *u8
extern fn mpg123_delete(mh: *u8)
extern fn mpg123_open(mh: *u8, path: *u8) -> i32
extern fn mpg123_close(mh: *u8) -> i32
extern fn mpg123_format_none(mh: *u8) -> i32
extern fn mpg123_format(mh: *u8, rate: i64, channels: i32, encodings: i32) -> i32
extern fn mpg123_getformat(mh: *u8, rate: *i64, channels: *i32, encoding: *i32) -> i32
extern fn mpg123_read(mh: *u8, outmemory: *u8, outmemsize: usize, done: *usize) -> i32

MPG123_OK:         i32 = 0
MPG123_DONE:       i32 = -12
MPG123_NEW_FORMAT: i32 = -11
MPG123_ENC_SIGNED_16: i32 = 0xD0

extern fn snd_pcm_open(pcm: **u8, name: *u8, stream: i32, mode: i32) -> i32
extern fn snd_pcm_close(pcm: *u8) -> i32
extern fn snd_pcm_set_params(pcm: *u8, format: i32, access: i32, channels: u32, rate: u32, soft_resample: i32, latency: u32) -> i32
extern fn snd_pcm_writei(pcm: *u8, buffer: *u8, size: u64) -> i64
extern fn snd_pcm_drain(pcm: *u8) -> i32
extern fn snd_pcm_recover(pcm: *u8, err: i32, silent: i32) -> i32
extern fn snd_pcm_avail_update(pcm: *u8) -> i64

import(os = "std/os")

SND_PCM_STREAM_PLAYBACK:      i32 = 0
SND_PCM_FORMAT_S16_LE:        i32 = 2
SND_PCM_ACCESS_RW_INTERLEAVED: i32 = 3
SND_PCM_NONBLOCK:             i32 = 1

# -EAGAIN: ALSA's "no room in the buffer right now" return, only possible
# in non-blocking mode (SND_PCM_NONBLOCK) — the mode open_output uses
# specifically so a full buffer never blocks the caller (see write_frames).
EAGAIN: i64 = -11

# Sound: fully decoded PCM, signed 16-bit little-endian, interleaved
# channels — the format both mpg123_format() forces on decode and ALSA's
# writei expects, so no per-sample conversion sits between the two.
struct Sound {
    pcm:      *u8,   # n_frames * channels * 2 bytes
    n_frames: usize,
    channels: i32,
    rate:     i32,
}

fn free_sound(s: Sound) {
    if s.pcm != null { free(s.pcm) }
}

# decode_mp3: fully decodes an MP3 file into memory as signed 16-bit PCM.
# Fine for the short sound effects/music loops 2D games actually use —
# streaming decode during playback is a straightforward extension of the
# same mpg123_read loop if a future caller ever needs it for long tracks.
fn decode_mp3(path: str) -> !Sound {
    mpg123_init()

    err: i32 = 0
    mh: *u8 = mpg123_new(null, &err)
    if mh == null { ret @err(1) }

    if mpg123_open(mh, path.data) != MPG123_OK {
        mpg123_delete(mh)
        ret @err(2)
    }

    rate: i64 = 0
    channels: i32 = 0
    encoding: i32 = 0
    if mpg123_getformat(mh, &rate, &channels, &encoding) != MPG123_OK {
        mpg123_close(mh)
        mpg123_delete(mh)
        ret @err(3)
    }
    mpg123_format_none(mh)
    mpg123_format(mh, rate, channels, MPG123_ENC_SIGNED_16)

    cap: usize = 1048576
    buf: *u8 = @alo(u8, cap)
    len: usize = 0

    chunk_cap: usize = 65536
    chunk: *u8 = @alo(u8, chunk_cap)

    done: bool = false
    while !done {
        got: usize = 0
        r: i32 = mpg123_read(mh, chunk, chunk_cap, &got)
        if got > 0 {
            if len + got > cap {
                while len + got > cap { cap = cap * 2 }
                buf = @realo(buf, u8, cap)
            }
            memcpy(buf + len, chunk, got)
            len += got
        }
        if r == MPG123_NEW_FORMAT {
            mpg123_getformat(mh, &rate, &channels, &encoding)
        } elif r != MPG123_OK {
            done = true # MPG123_DONE, or any error — either way, stop
        }
    }

    free(chunk)
    mpg123_close(mh)
    mpg123_delete(mh)

    bytes_per_frame: usize = @usize(channels) * 2
    n_frames: usize = len / bytes_per_frame

    ret Sound{.pcm=buf, .n_frames=n_frames, .channels=channels, .rate=@i32(rate)}
}

# AudioOutput: an open ALSA PCM playback handle. `device` is an ALSA PCM
# name — "default" for the system's default output, "null" for ALSA's
# hardware-free sink (useful for testing FFI plumbing on a machine with
# no real sound card, the same role Xvfb plays for std/graphics/gl).
struct AudioOutput {
    pcm:      *u8,
    channels: i32,
}

fn open_output(device: str, rate: i32, channels: i32) -> !AudioOutput {
    pcm: *u8 = null
    # SND_PCM_NONBLOCK: a blocking snd_pcm_writei stalls the calling
    # thread until the ALSA ring buffer has room — for a game's single-
    # threaded main loop calling play_sound() synchronously (e.g. once
    # per shot fired), that stall is a real frame-time hitch, not just a
    # theoretical one: it was reported as visible frame lag on every shot
    # in examples/games/astro_blaster. Non-blocking mode makes a full
    # buffer return -EAGAIN immediately instead — write_frames drops that
    # write (skips the sound rather than freezing the game) since a
    # missed frame of a short SFX clip is imperceptible either way.
    if snd_pcm_open(&pcm, device.data, SND_PCM_STREAM_PLAYBACK, SND_PCM_NONBLOCK) < 0 {
        ret @err(1)
    }
    if snd_pcm_set_params(pcm, SND_PCM_FORMAT_S16_LE, SND_PCM_ACCESS_RW_INTERLEAVED,
            @u32(channels), @u32(rate), 1, 500000u32) < 0 {
        snd_pcm_close(pcm)
        ret @err(2)
    }
    ret AudioOutput{.pcm=pcm, .channels=channels}
}

# write_frames: non-blocking write of `n_frames` interleaved sample
# frames — never stalls the caller (see open_output's SND_PCM_NONBLOCK
# comment). Checks snd_pcm_avail_update first and skips the write
# entirely (no snd_pcm_writei call at all) when there's plainly not
# enough room, rather than relying only on the write itself returning
# -EAGAIN promptly: some ALSA PCM plugins (notably PulseAudio's/
# PipeWire's ALSA-compat shim, common on desktop Linux) don't handle
# SND_PCM_NONBLOCK as cheaply as raw hardware ALSA does, so avoiding the
# write call altogether when it would fail anyway is a real margin, not
# just belt-and-suspenders. Returns the number of frames actually
# written, 0 if there was no room (checked up front, or EAGAIN from the
# write itself — either way "try again later" or, for one-shot SFX,
# "skip it"), or a negative ALSA error code for anything else. A single
# automatic xrun-recovery retry covers the common buffer-underrun case; a
# caller that wants more control can inspect the negative return itself.
fn write_frames(out: AudioOutput, pcm: *u8, n_frames: usize) -> i64 {
    avail: i64 = snd_pcm_avail_update(out.pcm)
    if avail >= 0 && avail < @i64(n_frames) { ret 0 }

    r: i64 = snd_pcm_writei(out.pcm, pcm, @u64(n_frames))
    if r == EAGAIN { ret 0 }
    if r < 0 {
        if snd_pcm_recover(out.pcm, @i32(r), 1) == 0 {
            r = snd_pcm_writei(out.pcm, pcm, @u64(n_frames))
            if r == EAGAIN { ret 0 }
        }
    }
    ret r
}

fn play_sound(out: AudioOutput, s: Sound) -> i64 {
    ret write_frames(out, s.pcm, s.n_frames)
}

# close_output: drains whatever's still queued before closing so a sound
# playing right at shutdown isn't cut off. snd_pcm_drain also honors
# SND_PCM_NONBLOCK — it can return -EAGAIN meaning "not finished yet,
# call again" rather than blocking — so this polls it to completion
# instead of trusting one call, the one place in this module a short
# wait is actually the desired behavior.
fn close_output(out: AudioOutput) {
    r: i32 = snd_pcm_drain(out.pcm)
    tries: i32 = 0
    while r == @i32(EAGAIN) && tries < 200 {
        os.sleep_ms(10)
        r = snd_pcm_drain(out.pcm)
        tries += 1
    }
    snd_pcm_close(out.pcm)
}
