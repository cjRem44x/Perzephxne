# std/str — string operations
# All functions that return new strings allocate on the heap.
# Caller is responsible for freeing if needed (raw pointer inside str).

extern fn strlen(s: *u8) -> usize
extern fn strcmp(a: *u8, b: *u8) -> i32
extern fn strncmp(a: *u8, b: *u8, n: usize) -> i32
extern fn strstr(haystack: *u8, needle: *u8) -> *u8
extern fn memcpy(dst: *u8, src: *u8, n: usize) -> *u8
extern fn malloc(n: usize) -> *u8
extern fn realloc(p: *u8, n: usize) -> *u8
extern fn toupper(c: i32) -> i32
extern fn tolower(c: i32) -> i32
extern fn isspace(c: i32) -> i32
extern fn isdigit(c: i32) -> i32
extern fn isalpha(c: i32) -> i32
extern fn isalnum(c: i32) -> i32

# len: return the length of a string
fn len(s: str) -> usize {
    ret s.len
}

# eq: true if two strings are equal
fn eq(a: str, b: str) -> bool {
    if a.len != b.len { ret false }
    ret strcmp(a.data, b.data) == 0
}

# concat: concatenate two strings, return new heap-allocated str
fn concat(a: str, b: str) -> str {
    total: usize = a.len + b.len
    buf: *u8 = malloc(total + 1)
    memcpy(buf, a.data, a.len)
    off: *u8 = buf + a.len
    memcpy(off, b.data, b.len)
    end: *u8 = buf + total
    end.* = 0u8
    ret @str_raw(buf, total)
}

# slice: return a heap-allocated null-terminated copy of s[start..end)
fn slice(s: str, start: usize, end: usize) -> str {
    if start > s.len { start = s.len }
    if end > s.len   { end   = s.len }
    if end < start   { end   = start }
    n: usize = end - start
    buf: *u8 = malloc(n + 1)
    memcpy(buf, s.data + start, n)
    term: *u8 = buf + n
    term.* = 0u8
    ret @str_raw(buf, n)
}

# find: return the byte offset of sub in s, or s.len if not found
fn find(s: str, sub: str) -> usize {
    if sub.len == 0 { ret 0 }
    if sub.len > s.len { ret s.len }
    limit: usize = s.len - sub.len
    i: usize = 0
    while i <= limit {
        if strncmp(s.data + i, sub.data, sub.len) == 0 {
            ret i
        }
        i = i + 1
    }
    ret s.len
}

# contains: true if sub appears anywhere in s
fn contains(s: str, sub: str) -> bool {
    ret find(s, sub) < s.len
}

# starts_with: true if s begins with prefix
fn starts_with(s: str, prefix: str) -> bool {
    if prefix.len > s.len { ret false }
    ret strncmp(s.data, prefix.data, prefix.len) == 0
}

# ends_with: true if s ends with suffix
fn ends_with(s: str, suffix: str) -> bool {
    if suffix.len > s.len { ret false }
    offset: usize = s.len - suffix.len
    ret strncmp(s.data + offset, suffix.data, suffix.len) == 0
}

# to_upper: return new heap string with all ASCII letters uppercased
fn to_upper(s: str) -> str {
    buf: *u8 = malloc(s.len + 1)
    i: usize = 0
    while i < s.len {
        c: i32 = @i32((s.data + i).*)
        b: *u8 = buf + i
        b.* = @u8(toupper(c))
        i = i + 1
    }
    end: *u8 = buf + s.len
    end.* = 0u8
    ret @str_raw(buf, s.len)
}

# to_lower: return new heap string with all ASCII letters lowercased
fn to_lower(s: str) -> str {
    buf: *u8 = malloc(s.len + 1)
    i: usize = 0
    while i < s.len {
        c: i32 = @i32((s.data + i).*)
        b: *u8 = buf + i
        b.* = @u8(tolower(c))
        i = i + 1
    }
    end: *u8 = buf + s.len
    end.* = 0u8
    ret @str_raw(buf, s.len)
}

# trim: strip leading and trailing ASCII whitespace
fn trim(s: str) -> str {
    start: usize = 0
    while start < s.len {
        c: i32 = @i32((s.data + start).*)
        if isspace(c) == 0 { break }
        start = start + 1
    }
    end: usize = s.len
    while end > start {
        c: i32 = @i32((s.data + end - 1).*)
        if isspace(c) == 0 { break }
        end = end - 1
    }
    ret slice(s, start, end)
}

# repeat: return s concatenated n times
fn repeat(s: str, n: usize) -> str {
    if n == 0 { ret @str_raw(malloc(1), 0) }
    total: usize = s.len * n
    buf: *u8 = malloc(total + 1)
    # `off` is declared once, before the loop, and reassigned (not
    # redeclared) inside it: a `let` inside a loop body allocates a fresh
    # stack slot on every iteration in this compiler (it isn't hoisted to
    # the function's entry block), which for a large `n` can exhaust the
    # stack well before the loop finishes.
    off: *u8 = buf
    i: usize = 0
    while i < n {
        off = buf + i * s.len
        memcpy(off, s.data, s.len)
        i = i + 1
    }
    end: *u8 = buf + total
    end.* = 0u8
    ret @str_raw(buf, total)
}

# index_of_char: return byte offset of first occurrence of ch, or s.len if absent
fn index_of_char(s: str, ch: u8) -> usize {
    i: usize = 0
    while i < s.len {
        if (s.data + i).* == ch { ret i }
        i = i + 1
    }
    ret s.len
}

# replace: replace the first occurrence of old with new_ in s
fn replace(s: str, old: str, new_: str) -> str {
    pos: usize = find(s, old)
    if pos == s.len { ret s }
    before: str = slice(s, 0, pos)
    after:  str = slice(s, pos + old.len, s.len)
    tmp: str = concat(before, new_)
    ret concat(tmp, after)
}

# replace_all: replace every non-overlapping occurrence of old with new_ in s
fn replace_all(s: str, old: str, new_: str) -> str {
    if old.len == 0 { ret s }
    result: str = @str_raw(malloc(1), 0)
    result_ptr: *u8 = result.data
    result_ptr.* = 0u8
    pos: usize = 0
    while pos <= s.len {
        next: usize = find(slice(s, pos, s.len), old)
        if next == s.len - pos {
            # no more occurrences — append remainder
            rest: str = slice(s, pos, s.len)
            result = concat(result, rest)
            break
        }
        seg: str = slice(s, pos, pos + next)
        result = concat(result, seg)
        result = concat(result, new_)
        pos = pos + next + old.len
    }
    ret result
}

# split_count: count the number of tokens when splitting s by delim
fn split_count(s: str, delim: str) -> usize {
    if s.len == 0 { ret 0 }
    if delim.len == 0 { ret s.len }
    count: usize = 1
    pos: usize = 0
    while pos <= s.len {
        next: usize = find(slice(s, pos, s.len), delim)
        if next == s.len - pos { break }
        count = count + 1
        pos = pos + next + delim.len
    }
    ret count
}

# split_next: extract one token from s starting at *pos, advance *pos past the delimiter.
# Returns the token. When pos reaches s.len, returns an empty str.
fn split_next(s: str, delim: str, pos: *usize) -> str {
    if pos.* >= s.len { ret @str_raw(s.data, 0) }
    if delim.len == 0 {
        tok: str = slice(s, pos.*, pos.* + 1)
        pos.* = pos.* + 1
        ret tok
    }
    rest: str = slice(s, pos.*, s.len)
    next: usize = find(rest, delim)
    tok: str = slice(s, pos.*, pos.* + next)
    if next == rest.len {
        pos.* = s.len
    } else {
        pos.* = pos.* + next + delim.len
    }
    ret tok
}

# is_digit: true if every character is an ASCII digit
fn is_digit_str(s: str) -> bool {
    if s.len == 0 { ret false }
    i: usize = 0
    while i < s.len {
        c: i32 = @i32((s.data + i).*)
        if isdigit(c) == 0 { ret false }
        i = i + 1
    }
    ret true
}

# is_alpha: true if every character is an ASCII letter
fn is_alpha_str(s: str) -> bool {
    if s.len == 0 { ret false }
    i: usize = 0
    while i < s.len {
        c: i32 = @i32((s.data + i).*)
        if isalpha(c) == 0 { ret false }
        i = i + 1
    }
    ret true
}
