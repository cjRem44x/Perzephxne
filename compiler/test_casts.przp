import "std/io" as io

fn main() {
    # valid numeric strings
    a: str = "42"
    b: str = "32767"
    c: str = "1000000"
    d: str = "9876543210"
    e: str = "3.14"
    f: str = "-7"

    # invalid / non-numeric strings — should all produce 0
    bad: str = "hello"
    empty: str = ""

    # i8 / u8
    v_i8:  i8  = @i8(a)
    v_u8:  u8  = @u8(a)
    io.println(@str(v_i8))
    io.println(@str(v_u8))

    # i16 / u16
    v_i16: i16 = @i16(b)
    v_u16: u16 = @u16(b)
    io.println(@str(v_i16))
    io.println(@str(v_u16))

    # i32 / u32
    v_i32: i32 = @i32(c)
    v_u32: u32 = @u32(c)
    io.println(@str(v_i32))
    io.println(@str(v_u32))

    # i64 / u64 / usize
    v_i64:   i64   = @i64(d)
    v_u64:   u64   = @u64(d)
    v_usize: usize = @usize(d)
    io.println(@str(v_i64))
    io.println(@str(v_u64))
    io.println(@str(v_usize))

    # f32 / f64
    v_f32: f32 = @f32(e)
    v_f64: f64 = @f64(e)
    io.println(@str(v_f64))

    # negative
    v_neg: i32 = @i32(f)
    io.println(@str(v_neg))

    # fallback: non-numeric → 0
    z_i32:  i32  = @i32(bad)
    z_i64:  i64  = @i64(bad)
    z_f64:  f64  = @f64(bad)
    z_i32e: i32  = @i32(empty)
    io.println(@str(z_i32))
    io.println(@str(z_i64))
    io.println(@str(z_f64))
    io.println(@str(z_i32e))
}
